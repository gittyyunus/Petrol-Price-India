---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';
import { Columns2, Plus, X, ArrowUpDown, TrendingUp, TrendingDown, ChevronRight } from '@lucide/astro';

const today = new Date().toISOString().split('T')[0];
const { data: cities } = await supabase.from('cities').select('*').order('city_name');
const { data: latestPricesData } = await supabase.from('prices').select('*').eq('date', today);
const latestPrices = latestPricesData || [];

const title = "Compare Petrol Prices — Side-by-Side Comparison";
const description = "Compare petrol prices across different cities in India. Select up to 4 cities and see side-by-side price comparison and history.";
---

<Base title={title} description={description}>
  <Navbar />
  
  <main class="flex-1 bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-ink">Home</a>
        <ChevronRight class="w-3 h-3" />
        <span class="text-ink">Compare</span>
      </nav>

      <header class="text-center mb-16">
        <div class="inline-flex items-center justify-center p-3 bg-primary/5 rounded-2xl mb-6">
          <Columns2 class="w-8 h-8 text-primary" />
        </div>
        <h1 class="text-4xl font-bold tracking-tight text-ink mb-4">Compare Cities</h1>
        <p class="text-lg text-body max-w-2xl mx-auto">
          Select up to 4 cities to compare their current petrol prices side-by-side.
        </p>
      </header>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16" id="compare-grid">
        {/* Comparison cards will be injected by JS */}
        <div class="bg-canvas/50 border-2 border-dashed border-hairline rounded-2xl p-8 flex flex-col items-center justify-center text-center group cursor-pointer hover:border-primary/20 hover:bg-canvas transition-all" id="add-city-btn">
          <div class="p-4 bg-canvas border border-hairline rounded-full mb-4 group-hover:scale-110 transition-transform">
            <Plus class="w-6 h-6 text-mute group-hover:text-primary" />
          </div>
          <p class="text-sm font-semibold text-body group-hover:text-ink">Add City to Compare</p>
        </div>
      </div>
      
      {/* Comparison Table */}
      <div id="comparison-table-container" class="hidden">
        <section class="bg-canvas border border-hairline rounded-2xl overflow-hidden shadow-sm">
          <div class="px-8 py-6 border-b border-hairline bg-canvas">
            <h2 class="text-xl font-bold text-ink">Comparison Details</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <tbody class="divide-y divide-hairline" id="comparison-table-body">
                {/* Rows injected by JS */}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
    
    {/* City Selection Modal */}
    <div id="city-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-ink/40 backdrop-blur-sm hidden">
      <div class="bg-canvas w-full max-w-md rounded-2xl shadow-2xl overflow-hidden animate-fade-in">
        <div class="p-6 border-b border-hairline flex justify-between items-center">
          <h3 class="font-bold text-lg">Select City</h3>
          <button id="close-modal" class="p-2 hover:bg-canvas-soft-2 rounded-full transition-colors">
            <X class="w-5 h-5 text-mute" />
          </button>
        </div>
        <div class="p-6">
          <input 
            type="text" 
            id="modal-search" 
            placeholder="Search city..." 
            class="w-full h-12 px-4 rounded-lg border border-hairline bg-canvas-soft-2 focus:bg-canvas outline-none mb-4"
          />
          <div class="max-h-64 overflow-y-auto space-y-1" id="modal-city-list">
            {cities?.map(c => (
              <button 
                class="w-full text-left px-4 py-3 rounded-lg hover:bg-canvas-soft-2 transition-colors flex justify-between items-center group"
                data-city-id={c.id}
                data-city-name={c.city_name}
                data-city-slug={c.city_slug}
              >
                <div>
                  <p class="font-medium text-ink">{c.city_name}</p>
                  <p class="text-[10px] text-mute font-mono uppercase tracking-tighter">{c.state_name}</p>
                </div>
                <Plus class="w-4 h-4 text-mute group-hover:text-primary" />
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Base>

<script define:vars={{ latestPrices }}>
  let selectedCities = [];
  const MAX_CITIES = 4;
  
  const grid = document.getElementById('compare-grid');
  const addBtn = document.getElementById('add-city-btn');
  const modal = document.getElementById('city-modal');
  const closeModal = document.getElementById('close-modal');
  const modalSearch = document.getElementById('modal-search');
  const modalCityList = document.getElementById('modal-city-list');
  const tableContainer = document.getElementById('comparison-table-container');
  const tableBody = document.getElementById('comparison-table-body');
  
  function updateUI() {
    // Clear current cards except add button
    const cards = grid.querySelectorAll('.city-card');
    cards.forEach(c => c.remove());
    
    // Calculate extremes if we have 4 cities
    let minPrice = Infinity;
    let maxPrice = -Infinity;
    const isFull = selectedCities.length === MAX_CITIES;
    
    if (isFull) {
      selectedCities.forEach(city => {
        const p = latestPrices.find(lp => lp.city_id === city.id)?.petrol_price;
        if (p !== undefined) {
          if (p < minPrice) minPrice = p;
          if (p > maxPrice) maxPrice = p;
        }
      });
    }

    selectedCities.forEach((city, index) => {
      const priceInfo = latestPrices.find(p => p.city_id === city.id);
      const isMin = isFull && priceInfo?.petrol_price === minPrice;
      const isMax = isFull && priceInfo?.petrol_price === maxPrice;

      const card = document.createElement('div');
      card.className = `city-card border rounded-2xl p-8 shadow-sm relative group animate-fade-in ${
        isMin ? 'bg-success/5 border-success/30' : 
        isMax ? 'bg-error/5 border-error/30' : 
        'bg-canvas border-hairline'
      }`;
      card.innerHTML = `
        <button class="absolute top-4 right-4 p-1.5 hover:bg-error/10 rounded-full transition-colors remove-city" data-index="${index}">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mute hover:text-error"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        <div class="mb-6">
          <p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">City ${index + 1}</p>
          <h3 class="text-xl font-bold text-ink">${city.name}</h3>
        </div>
        <div class="mb-2">
          <span class="text-4xl font-bold tracking-tight">₹${priceInfo?.petrol_price?.toFixed(2) || 'N/A'}</span>
          <span class="text-mute text-sm">/L</span>
        </div>
        <div class="flex items-center gap-1.5 text-xs font-semibold ${priceInfo?.price_change > 0 ? 'text-error' : priceInfo?.price_change < 0 ? 'text-success' : 'text-mute'}">
          ${priceInfo?.price_change > 0 ? '▲' : priceInfo?.price_change < 0 ? '▼' : '—'} 
          ₹${Math.abs(priceInfo?.price_change || 0).toFixed(2)}
        </div>
      `;
      grid.insertBefore(card, addBtn);
    });
    
    if (selectedCities.length >= MAX_CITIES) {
      addBtn.classList.add('hidden');
    } else {
      addBtn.classList.remove('hidden');
    }
    
    updateTable();
  }
  
  function updateTable() {
    if (selectedCities.length < 2) {
      tableContainer.classList.add('hidden');
      return;
    }
    
    tableContainer.classList.remove('hidden');
    
    let minPrice = Infinity;
    let maxPrice = -Infinity;
    const isFull = selectedCities.length === MAX_CITIES;
    
    if (isFull) {
      selectedCities.forEach(city => {
        const p = latestPrices.find(lp => lp.city_id === city.id)?.petrol_price;
        if (p !== undefined) {
          if (p < minPrice) minPrice = p;
          if (p > maxPrice) maxPrice = p;
        }
      });
    }

    const rows = [
      { label: 'Today\'s Price', key: 'petrol_price', prefix: '₹' },
      { label: 'Daily Change', key: 'price_change', prefix: '₹' },
    ];
    
    let tableHtml = rows.map(row => `
      <tr>
        <td class="px-8 py-6 text-sm font-semibold text-body bg-canvas-soft-2 w-48">${row.label}</td>
        ${selectedCities.map(city => {
          const priceInfo = latestPrices.find(p => p.city_id === city.id);
          const val = priceInfo?.[row.key];
          let colorClass = 'text-ink';
          if (isFull && row.key === 'petrol_price') {
            if (val === minPrice) colorClass = 'text-success font-bold';
            if (val === maxPrice) colorClass = 'text-error font-bold';
          }
          return `
            <td class="px-8 py-6 text-sm font-mono ${colorClass}">
              ${row.prefix}${val?.toFixed(2) || 'N/A'}
            </td>
          `;
        }).join('')}
      </tr>
    `).join('');

    if (isFull) {
      tableHtml += `
        <tr>
          <td class="px-8 py-6 text-sm font-semibold text-body bg-canvas-soft-2 w-48 italic">Diff. from Lowest</td>
          ${selectedCities.map(city => {
            const priceInfo = latestPrices.find(p => p.city_id === city.id);
            const val = priceInfo?.petrol_price;
            const diff = val !== undefined ? val - minPrice : null;
            let colorClass = 'text-ink';
            if (diff === 0) colorClass = 'text-success font-bold';
            else if (val === maxPrice) colorClass = 'text-error font-bold';
            
            return `
              <td class="px-8 py-6 text-sm font-mono ${colorClass}">
                ${diff !== null ? (diff === 0 ? 'Lowest' : '+₹' + diff.toFixed(2)) : 'N/A'}
              </td>
            `;
          }).join('')}
        </tr>
      `;
    }
    
    tableBody.innerHTML = tableHtml;
  }
  
  addBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
  closeModal?.addEventListener('click', () => modal?.classList.add('hidden'));
  
  modalCityList?.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (btn) {
      const id = parseInt(btn.dataset.cityId);
      const name = btn.dataset.cityName;
      const slug = btn.dataset.citySlug;
      
      if (!selectedCities.find(c => c.id === id)) {
        selectedCities.push({ id, name, slug });
        updateUI();
      }
      modal?.classList.add('hidden');
    }
  });
  
  grid?.addEventListener('click', (e) => {
    const removeBtn = e.target.closest('.remove-city');
    if (removeBtn) {
      const index = parseInt(removeBtn.dataset.index);
      selectedCities.splice(index, 1);
      updateUI();
    }
  });
  
  modalSearch?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    const cityBtns = modalCityList?.querySelectorAll('button');
    cityBtns?.forEach(btn => {
      const name = (btn.dataset.cityName || "").toLowerCase();
      if (name.includes(query)) {
        btn.classList.remove('hidden');
      } else {
        btn.classList.add('hidden');
      }
    });
  });
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fade-in {
    animation: fade-in 0.2s ease-out forwards;
  }
</style>
