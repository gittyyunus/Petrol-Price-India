---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PriceCard from '../components/PriceCard.astro';
import HeroSearch from '../components/HeroSearch.astro';
import { Search, MapPin, ArrowRight, Zap, TrendingUp, TrendingDown } from '@lucide/astro';
import { supabase } from '../lib/supabase';
import { formatPrice } from '../lib/utils';

// Get today's date in ISO format
const today = new Date().toISOString().split('T')[0];

// Fetch prices for major cities with their slugs
const majorCityNames = ["Mumbai", "Delhi", "Bangalore", "Chennai", "Hyderabad", "Kolkata", "Ahmedabad", "Pune"];
const { data: majorCitiesData } = await supabase
  .from('prices')
  .select('*, cities!inner(city_slug, state_slug)')
  .in('city_name', majorCityNames)
  .eq('date', today);

// Fetch top movers with slugs
const { data: topMoversUp } = await supabase
  .from('prices')
  .select('*, cities!inner(city_slug, state_slug)')
  .eq('date', today)
  .gt('price_change', 0)
  .order('price_change', { ascending: false })
  .limit(3);

const { data: topMoversDown } = await supabase
  .from('prices')
  .select('*, cities!inner(city_slug, state_slug)')
  .eq('date', today)
  .lt('price_change', 0)
  .order('price_change', { ascending: true })
  .limit(3);

// Fetch total city count for the search placeholder
const { count: cityCount } = await supabase
  .from('cities')
  .select('*', { count: 'exact', head: true });

// Fetch unique states for internal linking
const { data: statesData } = await supabase
  .from('cities')
  .select('state_name, state_slug')
  .not('state_slug', 'is', null);

const uniqueStates = Array.from(new Set(statesData?.map(s => JSON.stringify(s))))
  .map(s => JSON.parse(s))
  .sort((a, b) => a.state_name.localeCompare(b.state_name));

// Get a default city (Mumbai) for the hero card
const mumbaiPrice = majorCitiesData?.find(c => c.city_name === "Mumbai") || majorCitiesData?.[0];
const delhiPrice = majorCitiesData?.find(c => c.city_name === "Delhi");
const bangalorePrice = majorCitiesData?.find(c => c.city_name === "Bangalore");

const lastUpdatedTime = mumbaiPrice ? new Date(mumbaiPrice.scraped_at).toLocaleTimeString('en-IN', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: true,
  timeZone: 'Asia/Kolkata'
}) : "6:30 AM";

const title = "Petrol Price India — Today's Petrol Price in Delhi, Mumbai, Bangalore";
const description = "Track petrol price today in India. Get real-time updates for petrol price in delhi, mumbai, bangalore, hyderabad, pune and 700+ cities. Daily fuel price tracking and history.";

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why does the petrol price change every day in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In India, fuel prices are revised daily at 6:00 AM IST under the 'Dynamic Fuel Pricing' mechanism. This system ensures that fluctuations in international crude oil prices and the USD-INR exchange rate are passed on to consumers immediately."
      }
    },
    {
      "@type": "Question",
      "name": "Is petrol price going up in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Petrol prices in India fluctuate daily based on global crude oil benchmarks and the strength of the Rupee. Recently, trends have shown volatility due to geopolitical factors and global supply chain shifts."
      }
    },
    {
      "@type": "Question",
      "name": "Will petrol price increase in the coming days?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Future petrol price increases depend on OPEC production cuts, international demand, and domestic taxation policies. It is recommended to track the daily 6:00 AM updates for the most accurate forecast."
      }
    },
    {
      "@type": "Question",
      "name": "Why is petrol price high in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The high cost of petrol in India is primarily due to heavy taxation, including Central Excise Duty and State Value Added Tax (VAT), which can make up nearly 50% of the final retail price."
      }
    },
    {
      "@type": "Question",
      "name": "What is the current petrol price in Delhi?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `As of today, the petrol price in Delhi is ₹${delhiPrice?.petrol_price?.toFixed(2) || 'XX.XX'} per litre.`
      }
    },
    {
      "@type": "Question",
      "name": "What is the petrol price in Bangalore today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Today's petrol price in Bangalore is ₹${bangalorePrice?.petrol_price?.toFixed(2) || 'XX.XX'} per litre.`
      }
    },
    {
      "@type": "Question",
      "name": "What is the rate of 1 litre of petrol in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The rate of 1 litre of petrol varies by city, typically ranging between ₹95 to ₹110 across major Indian metros depending on local VAT rates.`
      }
    },
    {
      "@type": "Question",
      "name": "What's the price of petrol in India now?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The current price of petrol in India is determined by Oil Marketing Companies and varies by location. Major cities like Mumbai and Hyderabad often see the highest rates due to state taxes.`
      }
    }
  ]
};
---

<Base title={title} description={description}>
  {homepageFaqSchema && <script type="application/ld+json" set:html={JSON.stringify(homepageFaqSchema)} />}
  <Navbar />
  
  <main class="flex-1">
    {/* Hero Section */}
    <section class="relative bg-canvas pt-20 pb-32 overflow-hidden border-b border-hairline">
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-blue-50/50 via-magenta-50/20 to-transparent dark:from-blue-900/10 dark:via-magenta-900/5 blur-3xl opacity-50"></div>
      </div>
      
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft border border-hairline mb-8 animate-fade-in">
          <Zap class="w-3.5 h-3.5 text-warning fill-warning" />
          <span class="text-xs font-mono font-medium text-body uppercase tracking-wider">Prices updated daily</span>
        </div>
        
        <h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-ink mb-6 max-w-4xl mx-auto">
          Fuel Prices in India <br class="hidden sm:block" />
          <span class="text-mute">Tracked today.</span>
        </h1>

        <p class="text-lg sm:text-xl text-body max-w-2xl mx-auto mb-12 leading-relaxed">
          Get real-time <strong>petrol price</strong> for {cityCount || '700+'} cities across India. Minimal, fast, and data-driven insights for <strong>petrol price today</strong>.
        </p>
        
        <div class="mb-16">
          <HeroSearch />
          
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <span class="text-xs text-mute font-medium uppercase tracking-widest">Popular:</span>
            {["Mumbai", "Delhi", "Bangalore", "Chennai"].map(city => (
              <a href={`/petrol-price-in-${city.toLowerCase()}`} class="text-xs font-bold text-body hover:text-primary transition-colors">{city}</a>
            ))}
          </div>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 text-left max-w-5xl mx-auto">
          <div class="md:col-span-2">
            {mumbaiPrice && (
              <PriceCard 
                city={mumbaiPrice.city_name} 
                state={mumbaiPrice.state_name} 
                price={mumbaiPrice.petrol_price} 
                change={mumbaiPrice.price_change} 
                lastUpdated={`${lastUpdatedTime} Today`} 
                large={true}
                slug={mumbaiPrice.cities.city_slug}
              />
            )}
          </div>
          <div class="space-y-4">
            <div class="bg-canvas border border-hairline rounded-lg p-6 shadow-sm">
              <div class="flex items-center gap-2 mb-4">
                <MapPin class="w-4 h-4 text-mute" />
                <h3 class="text-sm font-semibold uppercase tracking-wider text-mute">Nearby Mumbai</h3>
              </div>
              <ul class="space-y-4">
                {majorCitiesData?.filter(c => c.city_name !== "Mumbai").slice(0, 3).map(city => (
                  <li class="flex justify-between items-center border-b border-hairline pb-2 last:border-0 last:pb-0">
                    <a href={`/petrol-price-in-${city.cities.city_slug}`} class="text-sm font-medium hover:text-primary transition-colors">{city.city_name}</a>
                    <span class="text-sm font-mono font-bold">₹{city.petrol_price?.toFixed(2) || 'N/A'}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a href="/calculator" class="block bg-primary p-6 rounded-lg text-canvas group">
              <div class="flex justify-between items-center mb-2">
                <h3 class="font-semibold">Fuel Calculator</h3>
                <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-1" />
              </div>
              <p class="text-sm text-canvas/80 leading-snug">Estimate your trip cost based on current prices.</p>
            </a>
          </div>
        </div>
      </div>
    </section>
    
    {/* SEO Content Section */}
    <section class="py-24 bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <article class="prose prose-neutral max-w-none">
          <h2 class="text-3xl font-bold text-ink mb-6">Understanding Petrol Price Today in India</h2>
          <p class="text-body mb-6">
            In the dynamic landscape of the Indian economy, the <strong>petrol price</strong> plays a pivotal role. Every citizen, from a daily commuter to a large-scale logistics operator, keeps a close eye on <strong>petrol price today</strong> to manage their daily expenses. At Petrol Price India, we provide real-time updates and comprehensive data to help you stay ahead of the curve.
          </p>
          
          <h2 class="text-3xl font-bold text-ink mb-6">Factors Affecting Petrol Price in Delhi and Major Cities</h2>
          <p class="text-body mb-6">
            The <strong>petrol price in delhi</strong> often serves as a benchmark for the rest of the country. However, several factors contribute to the final rate you pay at the pump. These include international crude oil prices, which are influenced by OPEC decisions, global supply chains, and geopolitical events. Additionally, the USD-INR exchange rate is a critical component, as India imports a significant portion of its crude oil requirements in dollars.
          </p>
          <p class="text-body mb-6">
            Domestic factors such as central excise duty and state-level Value Added Tax (VAT) also play a major role. While <strong>petrol price delhi</strong> might be influenced heavily by central policies, other cities like Mumbai and Bangalore see different rates due to varying state taxes and local surcharges. For instance, the <strong>petrol price in mumbai</strong> is historically higher because of the high VAT rates and additional cess imposed by the Maharashtra government.
          </p>

          <h3 class="text-2xl font-bold text-ink mb-4">Why Track Petrol Price Today?</h3>
          <p class="text-body mb-6">
            Tracking the <strong>petrol price today</strong> is essential because prices are revised every morning at 6:00 AM IST under the Dynamic Fuel Pricing mechanism. This policy ensures that international market fluctuations—whether a sudden drop in Brent crude or a hike due to supply disruptions—are passed on to consumers on a daily basis. By checking our tool, you can make informed decisions about whether to refuel your vehicle today or wait for a potential price drop tomorrow, potentially saving thousands over the course of a year.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">Petrol Price in Bangalore, Pune, and Hyderabad</h2>
          <p class="text-body mb-6">
            The major IT and industrial hubs of India, such as Bangalore, Pune, and Hyderabad, are particularly sensitive to fuel price hikes. The <strong>petrol price in bangalore</strong> often reflects the city's high consumption and state-specific cess intended for infrastructure development. Similarly, residents looking for the <strong>petrol price in pune</strong> or <strong>petrol price in hyderabad</strong> will find that prices vary significantly even within the same geographic region due to the location of oil depots and transportation costs.
          </p>
          <p class="text-body mb-6">
            Our platform offers localized insights for these cities, ensuring that you get the most accurate <strong>petrol price in india</strong> regardless of where you are located. We track data from over 700 cities and districts, providing a level of detail that covers everything from major metropolises to smaller municipal towns.
          </p>

          <h3 class="text-2xl font-bold text-ink mb-4">Historical Trends and Data Analysis</h3>
          <p class="text-body mb-6">
            Understanding historical data is just as important as knowing <strong>petrol price today</strong>. By analyzing trends over weeks or months, users can identify patterns in how prices react to international news. Our interactive charts allow you to visualize these trends, helping you understand the long-term impact on your wallet. For businesses involved in transport and logistics, this data is invaluable for fleet management and cost optimization.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">How Our Fuel Calculator Helps You Save</h2>
          <p class="text-body mb-6">
            Beyond just showing you the <strong>petrol price</strong>, we provide tools to help you budget. Our fuel calculator is designed with user convenience in mind. Simply input your vehicle's mileage and the total distance of your intended trip. The tool then calculates the total fuel cost based on the current <strong>petrol price today</strong>. This is particularly useful for planning long road trips, cross-country logistics, or even just calculating the monthly commute cost for your office staff.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">How Our Petrol Price Tracking Tool Works</h2>
          <p class="text-body mb-6">
            Accuracy and speed are the two pillars of our <strong>petrol price</strong> tracking platform. Our system is integrated with real-time data feeds from major Oil Marketing Companies (OMCs) across the country. Every morning at the stroke of 6:00 AM, our automated scrapers and API integrations fetch the latest rates for <strong>petrol price in delhi</strong>, Mumbai, and every other tracked city.
          </p>
          <p class="text-body mb-6">
            We don't just provide raw numbers; we add a layer of intelligence by calculating the day-on-day price change, the 30-day volatility index, and local market trends. This ensures that when you search for <strong>petrol price today</strong>, you aren't just seeing a number, but a piece of actionable financial data. Our fuel calculator is equally precise, using current market rates to provide near-perfect trip cost estimates, helping businesses and individuals alike to optimize their fuel consumption.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">The Future of Petrol Price in India</h2>
          <p class="text-body mb-12">
            As India moves towards more sustainable energy sources and aims for net-zero emissions, the <strong>petrol price in india</strong> will remain a critical economic indicator. The government's push for ethanol blending and the rapid adoption of electric vehicles are set to reshape the fuel market. However, for the foreseeable future, petrol will remain the primary fuel for millions. Staying informed with reliable, real-time data is your best defense against market volatility. Whether you are checking the <strong>petrol price delhi</strong> or looking for the cheapest fuel in a remote district, our platform is committed to providing you with the most accurate information.
          </p>
        </article>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="py-24 bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-ink mb-12 text-center">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">Why does the petrol price change every day in India?</h3>
            <p class="text-body">In India, fuel prices are revised daily at 6:00 AM IST under the "Dynamic Fuel Pricing" mechanism. This system ensures that fluctuations in international crude oil prices and the USD-INR exchange rate are passed on to consumers immediately.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">Is petrol price going up in India?</h3>
            <p class="text-body">Petrol prices in India fluctuate daily based on global crude oil benchmarks and the strength of the Rupee. Recently, trends have shown volatility due to geopolitical factors and global supply chain shifts.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">Why is petrol price high in India?</h3>
            <p class="text-body">The high cost of petrol in India is primarily due to heavy taxation, including Central Excise Duty and State Value Added Tax (VAT), which can make up nearly 50% of the final retail price.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">What is the current petrol price in Delhi?</h3>
            <p class="text-body">As of today, the petrol price in Delhi is <strong>₹{delhiPrice?.petrol_price?.toFixed(2) || 'XX.XX'}</strong> per litre. Prices are updated every morning at 6:00 AM.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">What is the petrol price in Bangalore today?</h3>
            <p class="text-body">Today's petrol price in Bangalore is <strong>₹{bangalorePrice?.petrol_price?.toFixed(2) || 'XX.XX'}</strong> per litre. You can track daily historical changes on our Bangalore-specific price page.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">What's the price of petrol in India now?</h3>
            <p class="text-body">The current price of petrol in India varies by location, typically ranging between ₹95 to ₹110. Major cities like Mumbai and Hyderabad often see higher rates due to state-level surcharges.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Top Movers */}
    <section class="py-24 bg-canvas-soft border-b border-hairline">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-baseline gap-4 mb-12">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-ink mb-2">Daily Top Movers</h2>
            <p class="text-body">Biggest price changes in India today.</p>
          </div>
          <div class="flex gap-2">
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas border border-hairline">
              <div class="w-2 h-2 rounded-full bg-error"></div>
              <span class="text-xs font-medium text-body">Increases</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas border border-hairline">
              <div class="w-2 h-2 rounded-full bg-success"></div>
              <span class="text-xs font-medium text-body">Decreases</span>
            </div>
          </div>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 bg-error/5 border-b border-hairline flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-error flex items-center gap-2">
                <TrendingUp class="w-4 h-4" /> Highest Increase
              </h3>
            </div>
            <div class="divide-y divide-hairline">
              {topMoversUp?.map(item => (
                <a href={`/petrol-price-in-${item.cities.city_slug}`} class="px-6 py-4 flex justify-between items-center hover:bg-canvas-soft-2 transition-colors">
                  <div>
                    <p class="font-semibold text-ink">{item.city_name}</p>
                    <p class="text-xs text-mute font-mono">{item.state_name}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-bold text-error">▲ +{item.price_change?.toFixed(2) || '0.00'}</p>
                    <p class="text-xs text-mute font-mono">₹{item.petrol_price?.toFixed(2) || 'N/A'}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
          
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 bg-success/5 border-b border-hairline flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-success flex items-center gap-2">
                <TrendingDown class="w-4 h-4" /> Biggest Drop
              </h3>
            </div>
            <div class="divide-y divide-hairline">
              {topMoversDown?.map(item => (
                <a href={`/petrol-price-in-${item.cities.city_slug}`} class="px-6 py-4 flex justify-between items-center hover:bg-canvas-soft-2 transition-colors">
                  <div>
                    <p class="font-semibold text-ink">{item.city_name}</p>
                    <p class="text-xs text-mute font-mono">{item.state_name}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-bold text-success">▼ {item.price_change?.toFixed(2) || '0.00'}</p>
                    <p class="text-xs text-mute font-mono">₹{item.petrol_price?.toFixed(2) || 'N/A'}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
    
    {/* Major Cities Grid */}
    <section class="py-24 bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-ink mb-2">Major Cities</h2>
            <p class="text-body">Fuel prices in major Indian metropolitans.</p>
          </div>
          <a href="/all-cities" class="text-sm font-semibold text-primary hover:underline flex items-center gap-1">
            View all cities <ArrowRight class="w-4 h-4" />
          </a>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {majorCitiesData?.map(city => (
            <PriceCard 
              city={city.city_name} 
              state={city.state_name} 
              price={city.petrol_price} 
              change={city.price_change} 
              lastUpdated={`${lastUpdatedTime} Today`} 
              slug={city.cities.city_slug}
            />
          ))}
        </div>
      </div>
    </section>

    {/* States Grid */}
    <section class="py-24 bg-canvas-soft">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-ink mb-12">Browse by State</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-6 gap-y-4">
          {uniqueStates.map(state => (
            <a 
              href={`/petrol-price-in-${state.state_slug}`} 
              class="text-sm font-medium text-body hover:text-primary transition-colors flex items-center gap-2"
            >
              <div class="w-1.5 h-1.5 rounded-full bg-hairline"></div>
              {state.state_name}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Base>

<script>
  // Simple geolocation detection
  async function detectCity() {
    try {
      const res = await fetch('https://ipapi.co/json/');
      const data = await res.json();
      if (data.city) {
        console.log("Detected city:", data.city);
      }
    } catch (e) {
      console.error("Geo detection failed", e);
    }
  }
  
  detectCity();
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }
</style>
