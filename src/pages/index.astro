---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PriceCard from '../components/PriceCard.astro';
import HeroSearch from '../components/HeroSearch.astro';
import { Search, MapPin, ArrowRight, Zap, TrendingUp, TrendingDown } from '@lucide/astro';
import { supabase } from '../lib/supabase';
import { formatPrice } from '../lib/utils';

// Get today's date in ISO format
const today = new Date().toISOString().split('T')[0];

// Latest available price date — the scraper runs on IST and can lag the UTC
// date, so every "today" query below uses this instead of `today`.
const { data: latestDateData } = await supabase
  .from('prices')
  .select('date')
  .order('date', { ascending: false })
  .limit(1);
const dataDate = latestDateData?.[0]?.date ?? today;

// Fetch prices for major cities with their slugs
const majorCityNames = ["Mumbai", "Delhi", "Bengaluru", "Chennai", "Hyderabad", "Kolkata", "Ahmedabad", "Pune"];
const { data: majorCitiesData } = await supabase
  .from('prices')
  .select('*, cities!inner(city_slug, state_slug)')
  .in('city_name', majorCityNames)
  .eq('date', dataDate);

// Fetch top movers with slugs
const { data: topMoversUp } = await supabase
  .from('prices')
  .select('*, cities!inner(city_slug, state_slug)')
  .eq('date', dataDate)
  .gt('price_change', 0)
  .order('price_change', { ascending: false })
  .limit(3);

const { data: topMoversDown } = await supabase
  .from('prices')
  .select('*, cities!inner(city_slug, state_slug)')
  .eq('date', dataDate)
  .lt('price_change', 0)
  .order('price_change', { ascending: true })
  .limit(3);

// Fetch total city count for the search placeholder
const { count: cityCount } = await supabase
  .from('cities')
  .select('*', { count: 'exact', head: true });

// Fetch unique states for internal linking
const { data: statesData } = await supabase
  .from('cities')
  .select('state_name, state_slug')
  .not('state_slug', 'is', null);

const uniqueStates = Array.from(new Set(statesData?.map(s => JSON.stringify(s))))
  .map(s => JSON.parse(s))
  // 'pondicherry' is a legacy slug merged into 'puducherry' (301 redirect in
  // [fuel]-price-in-[slug].astro). Never link it or the sitemap/page will
  // expose duplicate state URLs.
  .filter(s => s.state_slug !== 'pondicherry')
  .sort((a, b) => a.state_name.localeCompare(b.state_name));

// Get a default city (Mumbai) for the hero card
const mumbaiPrice = majorCitiesData?.find(c => c.city_name === "Mumbai") || majorCitiesData?.[0];
// Bengaluru is stored as "Bengaluru"; display as "Bangalore" but also match the alias
const displayCityName = (name: string) => name === "Bengaluru" ? "Bangalore" : name;
const delhiPrice = majorCitiesData?.find(c => c.city_name === "Delhi");
const bangalorePrice = majorCitiesData?.find(c => ["Bengaluru", "Bangalore"].includes(c.city_name));

const lastUpdatedTime = mumbaiPrice ? new Date(mumbaiPrice.scraped_at).toLocaleTimeString('en-IN', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: true,
  timeZone: 'Asia/Kolkata'
}) : "6:30 AM";

const title = "Fuel Prices India — Today's Fuel Prices in Delhi, Mumbai, Bangalore";
const description = `Track fuel prices today in India. Get real-time updates for fuel prices in delhi, mumbai, bangalore, hyderabad, pune and ${cityCount || 505} cities. Daily fuel price tracking and history.`;

// Render today's price with a graceful fallback if data hasn't synced yet.
const priceText = (p?: { petrol_price?: number | null } | null) =>
  p?.petrol_price != null ? `₹${p.petrol_price.toFixed(2)}` : null;

const delhiPriceText = priceText(delhiPrice);
const bangalorePriceText = priceText(bangalorePrice);

// Only show the movers section when there is at least one mover to show.
// Fuel prices are often frozen for weeks, so both lists are regularly empty.
const hasTopMovers = (topMoversUp?.length || 0) > 0 || (topMoversDown?.length || 0) > 0;

const faqEntity = [
  {
    "@type": "Question",
    "name": "Why does the petrol price change every day in India?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "In India, fuel prices are revised daily at 6:00 AM IST under the 'Dynamic Fuel Pricing' mechanism. This system ensures that fluctuations in international crude oil prices and the USD-INR exchange rate are passed on to consumers immediately."
    }
  },
  {
    "@type": "Question",
    "name": "Is petrol price going up in India?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Petrol prices in India fluctuate daily based on global crude oil benchmarks and the strength of the Rupee. Recently, trends have shown volatility due to geopolitical factors and global supply chain shifts."
    }
  },
  {
    "@type": "Question",
    "name": "Will petrol price increase in the coming days?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Future petrol price increases depend on OPEC production cuts, international demand, and domestic taxation policies. It is recommended to track the daily 6:00 AM updates for the most accurate forecast."
    }
  },
  {
    "@type": "Question",
    "name": "Why is petrol price high in India?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The high cost of petrol in India is primarily due to heavy taxation, including Central Excise Duty and State Value Added Tax (VAT), which can make up nearly 50% of the final retail price."
    }
  },
  // City-specific answers are only published when today's price actually
  // exists — never emit "not yet updated" placeholders into FAQ schema.
  ...(delhiPriceText ? [
    {
      "@type": "Question",
      "name": "What is the current petrol price in Delhi?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `As of today, the petrol price in Delhi is ${delhiPriceText} per litre.`
      }
    },
  ] : []),
  ...(bangalorePriceText ? [
    {
      "@type": "Question",
      "name": "What is the petrol price in Bangalore today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Today's petrol price in Bangalore is ${bangalorePriceText} per litre.`
      }
    },
  ] : []),
  {
    "@type": "Question",
    "name": "What is the rate of 1 litre of petrol in India?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `The rate of 1 litre of petrol varies by city, typically ranging between ₹95 to ₹110 across major Indian metros depending on local VAT rates.`
    }
  },
  {
    "@type": "Question",
    "name": "What's the price of petrol in India now?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `The current price of petrol in India is determined by Oil Marketing Companies and varies by location. Major cities like Mumbai and Hyderabad often see the highest rates due to state taxes.`
    }
  }
];

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": { "@type": "Organization", "name": "Petrol Price India" },
      "publisher": { "@type": "Organization", "name": "Petrol Price India" },
      "datePublished": "2025-01-01",
      "dateModified": today,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://petrolpriceindia.com"
      },
      "hasPart": {
        "@type": "FAQPage",
        "mainEntity": faqEntity
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://petrolpriceindia.com"
        }
      ]
    }
  ]
};
---

<Base title={title} description={description}>
  {homepageSchema && <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />}
  <Navbar />
  
  <main class="flex-1">
    {/* Hero Section */}
    <section class="relative bg-canvas pt-20 pb-32 overflow-hidden border-b border-hairline">
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-blue-50/50 via-magenta-50/20 to-transparent dark:from-blue-900/10 dark:via-magenta-900/5 blur-3xl opacity-50"></div>
      </div>
      
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft border border-hairline mb-8 animate-fade-in">
          <Zap class="w-3.5 h-3.5 text-warning fill-warning" />
          <span class="text-xs font-mono font-medium text-body uppercase tracking-wider">Prices updated daily</span>
        </div>
        
        <h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-ink mb-6 max-w-4xl mx-auto">
          Fuel Prices in India. <br class="hidden sm:block" />
          <span class="text-mute">Tracked today.</span>
        </h1>

        <p class="text-lg sm:text-xl text-body max-w-2xl mx-auto mb-12 leading-relaxed">
           Get real-time <strong>fuel prices</strong> for {cityCount || 505} cities across India. Minimal, fast, and data-driven insights for <strong>fuel prices today</strong>.
        </p>
        
        <div class="mb-16">
          <HeroSearch />
          
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <span class="text-xs text-mute font-medium uppercase tracking-widest">Popular:</span>
            {["Mumbai", "Delhi", "Bangalore", "Chennai"].map(city => (
              <a href={`/petrol-price-in-${city.toLowerCase()}`} class="text-xs font-bold text-body hover:text-primary transition-colors">{city}</a>
            ))}
          </div>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 text-left max-w-5xl mx-auto">
          <div class="md:col-span-2">
            {mumbaiPrice && (
              <PriceCard 
                city={mumbaiPrice.city_name} 
                state={mumbaiPrice.state_name} 
                price={mumbaiPrice.petrol_price} 
                change={mumbaiPrice.price_change} 
                lastUpdated={`${lastUpdatedTime} Today`} 
                large={true}
                slug={mumbaiPrice.cities.city_slug}
              />
            )}
          </div>
          <div class="space-y-4">
            <div class="bg-canvas border border-hairline rounded-lg p-6 shadow-sm">
              <div class="flex items-center gap-2 mb-4">
                <MapPin class="w-4 h-4 text-mute" />
                <h3 class="text-sm font-semibold uppercase tracking-wider text-mute">Nearby Mumbai</h3>
              </div>
              <ul class="space-y-4">
                {majorCitiesData?.filter(c => c.city_name !== "Mumbai").slice(0, 3).map(city => (
                  <li class="flex justify-between items-center border-b border-hairline pb-2 last:border-0 last:pb-0">
                    <a href={`/petrol-price-in-${city.cities.city_slug}`} class="text-sm font-medium hover:text-primary transition-colors">{city.city_name}</a>
                    <span class="text-sm font-mono font-bold">₹{city.petrol_price?.toFixed(2) || 'N/A'}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a href="/calculator" class="block bg-primary p-6 rounded-lg text-canvas group">
              <div class="flex justify-between items-center mb-2">
                <h3 class="font-semibold">Fuel Calculator</h3>
                <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-1" />
              </div>
              <p class="text-sm text-canvas/80 leading-snug">Estimate your trip cost based on current prices.</p>
            </a>
          </div>
        </div>
      </div>
    </section>
    
    {/* SEO Content Section */}
    <section class="py-24 bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <article class="prose prose-neutral max-w-none">
          <h2 class="text-3xl font-bold text-ink mb-6">Understanding Fuel Prices in India</h2>
          <p class="text-body mb-6">
            India's fuel prices are among the most closely watched numbers in the country — not because they swing wildly from one day to the next, but because they move often enough that keeping up takes genuine effort. Under the Dynamic Fuel Pricing mechanism introduced in 2017, petrol and diesel rates are revised every morning at 6:00 AM IST, tracking the latest international crude oil prices, the rupee-dollar exchange rate, and each state's tax structure. Petrol Price India exists to take the guesswork out of that daily churn. We publish live rates for Petrol, Diesel, CNG, and Autogas (automotive LPG) across {cityCount || 505} cities and districts, along with historical trends and tools for comparing one place against another. Looking up the <strong>petrol price in Delhi</strong> is a good starting point — every city page, from the big metros to small district towns, follows the same layout, so the data reads the same way no matter where you search.
          </p>
          <p class="text-body mb-6">
            There is no single "national fuel price," and that's the part that surprises most people. India actually runs a patchwork of thousands of local prices. The base cost of a litre — the landed cost of crude plus refining and distribution expenses — is broadly similar across the country. What differs from one pump to the next is the tax layer stacked on top. The central government applies a uniform excise duty, but each state sets its own Value Added Tax, and several add extra surcharges, local cess, or octroi on top. That is why the same litre of petrol can cost ₹10 or more extra in one city compared with another a few hundred kilometres away. Our <a href="/blog/how-fuel-excise-duty-and-state-vat-are-calculated/" class="text-primary hover:underline font-semibold">excise and VAT explainer</a> walks through this arithmetic step by step, from base price to the final bill at the pump.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">Why Prices Differ Between Cities and States</h2>
          <p class="text-body mb-6">
            The gap between cities isn't random, and it's worth understanding before you fill up, plan a trip, or budget a fleet's fuel spend. States treat fuel VAT as a major revenue source — petrol, diesel, and their alternatives sit outside the Goods and Services Tax — so the rate each state picks is as much a policy decision as a revenue one. Take two metros as an example: the <strong>petrol price in Mumbai</strong> is among the highest in the country because Maharashtra stacks steep VAT and extra levies on top, while the <strong>petrol price in Delhi</strong> stays closer to the national floor thanks to a comparatively modest state tax. Smaller factors nudge the number in particular places too: how far a city sits from a distribution depot, local dealer margins, and municipal charges.
          </p>
          <p class="text-body mb-6">
            None of this is easy to hold in your head, which is precisely why we track it. Open any city's page and you'll see today's price, yesterday's, and a running history — enough to tell whether a jump was a routine morning revision, a state budget decision, or a one-off local change. The <a href="/blog/state-wise-petrol-price-ranking-2026/" class="text-primary hover:underline font-semibold">state-wise ranking</a> places each state's average against the rest of the country, and the <a href="/compare" class="text-primary hover:underline font-semibold">compare tool</a> lines up multiple cities side by side so you can see the spread for yourself.
          </p>

          <h3 class="text-2xl font-bold text-ink mb-4">The Four Fuel Types We Cover</h3>
          <p class="text-body mb-6">
            The site tracks four fuels, each with its own pricing logic:
          </p>
          <ul class="list-disc pl-6 mb-6 space-y-2 text-body">
            <li><strong>Petrol</strong> — the default fuel for most cars and motorcycles, and the most-watched price on the site.</li>
            <li><strong>Diesel</strong> — the workhorse for trucks, buses, and tractors, and an increasingly common choice for SUVs. It carries a lower central excise duty than petrol, which is why it usually costs less per litre in the same city.</li>
            <li><strong>CNG</strong> — compressed natural gas, sold by the kilogram rather than the litre, and typically the cheapest option where it's available. It's the fuel behind most city-run and private fleets, autorickshaws, and taxis.</li>
            <li><strong>Autogas</strong> — automotive-grade LPG used mainly by autorickshaws and retrofitted vehicles. It's a different product from the cooking-gas cylinder, even though both are liquefied petroleum gas.</li>
          </ul>
          <p class="text-body mb-6">
            Petrol and diesel follow the daily 6 AM revision; CNG and Autogas are repriced less often because they're measured by weight and their supply chains differ. Each fuel has a dedicated page explaining how its own price is put together.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">How to Use the Site</h2>
          <p class="text-body mb-6">
            The tools on Petrol Price India are built around a few simple tasks:
          </p>
          <ul class="list-disc pl-6 mb-6 space-y-2 text-body">
            <li><strong>City search</strong> — type any city or town into the search bar to pull up its current price and recent history — the petrol price in Chennai, Kochi, Lucknow, or any of the other {cityCount || 505} locations we track.</li>
            <li><strong>Compare</strong> — stack two or more cities against each other to see exactly how much the state tax layer costs you.</li>
            <li><a href="/calculator" class="text-primary hover:underline font-semibold"><strong>Fuel calculator</strong></a> — enter your vehicle's mileage and trip distance to estimate your spend at today's rates, which is especially handy before a long road trip.</li>
            <li><strong>Historical trends</strong> — every city page includes a chart of past prices, useful for spotting a pattern before you time a fill-up or plan a long haul.</li>
          </ul>
          <p class="text-body mb-6">
            The value of all this is context, not just a number. A single price tells you what you'll pay today; the trend tells you whether prices are drifting up or down, and a comparison tells you whether you're paying more than you would a short drive away. If you're about to drive from Mumbai to Pune, or budgeting monthly fuel costs for a delivery fleet running across Bangalore and Hyderabad, having today's price, yesterday's price, and a six-week history in one place makes the decision straightforward.
          </p>

          <h2 class="text-3xl font-bold text-ink mb-6">Fuel Prices Going Forward</h2>
          <p class="text-body mb-12">
            Fuel prices will remain a daily economic indicator for years, even as ethanol blending expands and electric vehicles gain ground. Petrol and diesel still power the overwhelming majority of India's vehicles, and CNG and Autogas infrastructure keeps spreading into new cities. What changes is how easy it is to stay informed. Whether you're checking the petrol price in Hyderabad or in a smaller town, Petrol Price India is designed to give you accurate, up-to-date figures in a format that's quick to read and easy to act on.
          </p>
        </article>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="py-24 bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-ink mb-12 text-center">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">Why does the petrol price change every day in India?</h3>
            <p class="text-body">In India, fuel prices are revised daily at 6:00 AM IST under the "Dynamic Fuel Pricing" mechanism. This system ensures that fluctuations in international crude oil prices and the USD-INR exchange rate are passed on to consumers immediately.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">Is petrol price going up in India?</h3>
            <p class="text-body">Petrol prices in India fluctuate daily based on global crude oil benchmarks and the strength of the Rupee. Recently, trends have shown volatility due to geopolitical factors and global supply chain shifts.</p>
          </div>
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">Why is petrol price high in India?</h3>
            <p class="text-body">The high cost of petrol in India is primarily due to heavy taxation, including Central Excise Duty and State Value Added Tax (VAT), which can make up nearly 50% of the final retail price.</p>
          </div>
          {delhiPriceText && (
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
              <h3 class="text-lg font-bold text-ink mb-2">What is the current petrol price in Delhi?</h3>
              <p class="text-body">As of today, the petrol price in Delhi is <strong>{delhiPriceText}</strong> per litre. Prices are updated every morning at 6:00 AM.</p>
            </div>
          )}
          {bangalorePriceText && (
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
              <h3 class="text-lg font-bold text-ink mb-2">What is the petrol price in Bangalore today?</h3>
              <p class="text-body">Today's petrol price in Bangalore is <strong>{bangalorePriceText}</strong> per litre. You can track daily historical changes on our Bangalore-specific price page.</p>
            </div>
          )}
          <div class="bg-canvas-soft border border-hairline rounded-xl p-6">
            <h3 class="text-lg font-bold text-ink mb-2">What's the price of petrol in India now?</h3>
            <p class="text-body">The current price of petrol in India varies by location, typically ranging between ₹95 to ₹110. Major cities like Mumbai and Hyderabad often see higher rates due to state-level surcharges.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Top Movers — hidden entirely when prices are frozen and both lists are empty */}
    {hasTopMovers && (
    <section class="py-24 bg-canvas-soft border-b border-hairline">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-baseline gap-4 mb-12">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-ink mb-2">Daily Top Movers</h2>
            <p class="text-body">Biggest price changes in India today.</p>
          </div>
          <div class="flex gap-2">
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas border border-hairline">
              <div class="w-2 h-2 rounded-full bg-error"></div>
              <span class="text-xs font-medium text-body">Increases</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas border border-hairline">
              <div class="w-2 h-2 rounded-full bg-success"></div>
              <span class="text-xs font-medium text-body">Decreases</span>
            </div>
          </div>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 bg-error/5 border-b border-hairline flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-error flex items-center gap-2">
                <TrendingUp class="w-4 h-4" /> Highest Increase
              </h3>
            </div>
            <div class="divide-y divide-hairline">
              {(topMoversUp?.length || 0) > 0 ? topMoversUp?.map(item => (
                <a href={`/petrol-price-in-${item.cities.city_slug}`} class="px-6 py-4 flex justify-between items-center hover:bg-canvas-soft-2 transition-colors">
                  <div>
                    <p class="font-semibold text-ink">{item.city_name}</p>
                    <p class="text-xs text-mute font-mono">{item.state_name}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-bold text-error">▲ +{item.price_change?.toFixed(2) || '0.00'}</p>
                    <p class="text-xs text-mute font-mono">₹{item.petrol_price?.toFixed(2) || 'N/A'}</p>
                  </div>
                </a>
              )) : (
                <p class="px-6 py-8 text-sm text-body">No increases recorded today — prices held steady.</p>
              )}
            </div>
          </div>
          
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 bg-success/5 border-b border-hairline flex items-center justify-between">
              <h3 class="text-sm font-bold uppercase tracking-wider text-success flex items-center gap-2">
                <TrendingDown class="w-4 h-4" /> Biggest Drop
              </h3>
            </div>
            <div class="divide-y divide-hairline">
              {(topMoversDown?.length || 0) > 0 ? topMoversDown?.map(item => (
                <a href={`/petrol-price-in-${item.cities.city_slug}`} class="px-6 py-4 flex justify-between items-center hover:bg-canvas-soft-2 transition-colors">
                  <div>
                    <p class="font-semibold text-ink">{item.city_name}</p>
                    <p class="text-xs text-mute font-mono">{item.state_name}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-bold text-success">▼ {item.price_change?.toFixed(2) || '0.00'}</p>
                    <p class="text-xs text-mute font-mono">₹{item.petrol_price?.toFixed(2) || 'N/A'}</p>
                  </div>
                </a>
              )) : (
                <p class="px-6 py-8 text-sm text-body">No drops recorded today — prices held steady.</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
    )}
    
    {/* Major Cities Grid */}
    <section class="py-24 bg-canvas border-b border-hairline">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-ink mb-2">Major Cities</h2>
            <p class="text-body">Fuel prices in major Indian metropolitans.</p>
          </div>
          <a href="/all-cities" class="text-sm font-semibold text-primary hover:underline flex items-center gap-1">
            View all cities <ArrowRight class="w-4 h-4" />
          </a>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {majorCitiesData?.map(city => (
            <PriceCard 
              city={city.city_name} 
              state={city.state_name} 
              price={city.petrol_price} 
              change={city.price_change} 
              lastUpdated={`${lastUpdatedTime} Today`} 
              slug={city.cities.city_slug}
            />
          ))}
        </div>
      </div>
    </section>

    {/* States Grid */}
    <section class="py-24 bg-canvas-soft">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-ink mb-12">Browse by State</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-6 gap-y-4">
          {uniqueStates.map(state => (
            <a 
              href={`/petrol-price-in-${state.state_slug}`} 
              class="text-sm font-medium text-body hover:text-primary transition-colors flex items-center gap-2"
            >
              <div class="w-1.5 h-1.5 rounded-full bg-hairline"></div>
              {state.state_name}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Base>

<script>
  // Simple geolocation detection
  async function detectCity() {
    try {
      const res = await fetch('https://ipapi.co/json/');
      const data = await res.json();
      if (data.city) {
        console.log("Detected city:", data.city);
      }
    } catch (e) {
      console.error("Geo detection failed", e);
    }
  }
  
  detectCity();
</script>

