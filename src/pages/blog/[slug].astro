---
import { getEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ChevronRight } from '@lucide/astro';

const { slug } = Astro.params;

const post = slug ? await getEntry('blog', slug) : undefined;

if (!post || post.data.draft) {
  return Astro.redirect('/blog', 404);
}

const { Content } = await render(post);

const allPosts = (await getCollection('blog')).filter(p => !p.data.draft);
const index = allPosts.findIndex(p => p.id === post.id);
const prev = index > 0 ? allPosts[index - 1] : null;
const next = index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : null;

const fullTitle = `${post.data.title} | Petrol Price India`;
const date = post.data.pubDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });

const siteURL = 'https://petrolpriceindia.com';
const articleURL = `${siteURL}/blog/${post.id}/`;
const publishedISO = post.data.pubDate.toISOString();
const modifiedISO = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const heroImage = post.data.heroImage
  ? {
      "@type": "ImageObject",
      "url": `${siteURL}${post.data.heroImage}`,
      ...(post.data.heroImageWidth ? { "width": post.data.heroImageWidth } : {}),
      ...(post.data.heroImageHeight ? { "height": post.data.heroImageHeight } : {})
    }
  : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": heroImage,
  "author": {
    "@type": "Person",
    "name": "Yunus",
    "url": `${siteURL}/about/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Petrol Price India",
    "url": siteURL,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteURL}/favicon.svg`
    }
  },
  "datePublished": publishedISO,
  "dateModified": modifiedISO,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleURL
  },
  "url": articleURL
};
---

<Base title={fullTitle} description={post.data.description} articlePublishedTime={publishedISO} articleModifiedTime={modifiedISO} ogImage={post.data.heroImage}>
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  <Navbar />

  <main class="flex-1 bg-canvas-soft">
    <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-ink">Home</a>
        <ChevronRight class="w-3 h-3" />
        <a href="/blog/" class="hover:text-ink">Blog</a>
        <ChevronRight class="w-3 h-3" />
        <span class="text-ink">{post.data.title}</span>
      </nav>

      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-body hover:text-ink transition-colors mb-8">
        &larr; Back to Blog
      </a>

      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4">
          <span class="text-sm text-mute">{date}</span>
          <span class="text-sm px-2 py-1 bg-canvas-soft-2 text-body rounded-full">{post.data.category}</span>
          <span class="w-1 h-1 rounded-full bg-hairline"></span>
          <a href="/about/" class="inline-flex items-center gap-2 text-sm font-medium text-body hover:text-primary transition-colors" rel="author">
            <span class="w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline inline-flex items-center justify-center text-[11px] font-bold text-mute">Y</span>
            <span>By <span class="font-semibold text-ink">Yunus</span></span>
          </a>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink mb-4 leading-tight">{post.data.title}</h1>
        <p class="text-lg text-body leading-relaxed">{post.data.description}</p>
      </header>

      {
        post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            width={post.data.heroImageWidth}
            height={post.data.heroImageHeight}
            class="w-full h-auto rounded-xl border border-hairline mb-10"
            loading="eager"
          />
        )
      }

      <div class="prose-text space-y-5">
        <Content />
      </div>

      <div class="mt-12 flex flex-wrap gap-2">
        {
          post.data.tags.map(tag => (
            <span class="text-xs px-2 py-1 bg-canvas-soft-2 text-mute rounded-full">#{tag}</span>
          ))
        }
      </div>

      <nav class="mt-12 pt-8 border-t border-hairline flex justify-between">
        {
          prev ? (
            <a href={`/blog/${prev.id}`} class="text-sm text-body hover:text-ink transition-colors max-w-[45%]">
              <span class="block text-mute mb-1">&larr; Previous</span>
              {prev.data.title}
            </a>
          ) : <span />
        }
        {
          next ? (
            <a href={`/blog/${next.id}`} class="text-sm text-body hover:text-ink transition-colors text-right max-w-[45%]">
              <span class="block text-mute mb-1">Next &rarr;</span>
              {next.data.title}
            </a>
          ) : <span />
        }
      </nav>
    </article>
  </main>

  <Footer />
</Base>