---
import { getEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;

const post = slug ? await getEntry('blog', slug) : undefined;

if (!post || post.data.draft) {
  return Astro.redirect('/blog', 404);
}

const { Content } = await render(post);

const allPosts = (await getCollection('blog')).filter(p => !p.data.draft);
const index = allPosts.findIndex(p => p.id === post.id);
const prev = index > 0 ? allPosts[index - 1] : null;
const next = index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : null;

const fullTitle = `${post.data.title} | Petrol Price India`;
const date = post.data.pubDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={fullTitle} description={post.data.description}>
  <Navbar />

  <main class="flex-1 bg-canvas-soft">
    <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-body hover:text-ink transition-colors mb-8">
        &larr; Back to Blog
      </a>

      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-sm text-mute">{date}</span>
          <span class="text-sm px-2 py-1 bg-canvas-soft-2 text-body rounded-full">{post.data.category}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink mb-4 leading-tight">{post.data.title}</h1>
        <p class="text-lg text-body leading-relaxed">{post.data.description}</p>
      </header>

      <div class="prose-text space-y-5">
        <Content />
      </div>

      <div class="mt-12 flex flex-wrap gap-2">
        {
          post.data.tags.map(tag => (
            <span class="text-xs px-2 py-1 bg-canvas-soft-2 text-mute rounded-full">#{tag}</span>
          ))
        }
      </div>

      <nav class="mt-12 pt-8 border-t border-hairline flex justify-between">
        {
          prev ? (
            <a href={`/blog/${prev.id}`} class="text-sm text-body hover:text-ink transition-colors max-w-[45%]">
              <span class="block text-mute mb-1">&larr; Previous</span>
              {prev.data.title}
            </a>
          ) : <span />
        }
        {
          next ? (
            <a href={`/blog/${next.id}`} class="text-sm text-body hover:text-ink transition-colors text-right max-w-[45%]">
              <span class="block text-mute mb-1">Next &rarr;</span>
              {next.data.title}
            </a>
          ) : <span />
        }
      </nav>
    </article>
  </main>

  <Footer />
</Base>