---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Mail } from '@lucide/astro';
---

<Base 
  title="Contact Us | Petrol Price India" 
  description="Get in touch with Petrol Price India. We value your feedback, questions, and suggestions regarding our fuel price tracking services."
>
  <Navbar />
  
  <main class="flex-grow">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl mb-4">Contact Us</h1>
        <p class="text-lg text-body max-w-2xl mx-auto">Have questions or feedback? I'd love to hear from you.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Contact Information -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-semibold mb-6">Get in Touch</h2>
            <p class="text-body mb-8">
              As a solo developer running this platform, I personally read and respond to all feedback, bug reports, and data inquiries. I aim to get back to all messages within 24-48 hours.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="p-3 bg-canvas-soft rounded-lg text-ink">
                <Mail class="h-6 w-6" />
              </div>
              <div>
                <h3 class="font-medium text-ink">Email Support</h3>
                <p class="text-body text-sm">yunusshabbir53@gmail.com</p>
                <p class="text-mute text-xs mt-1">For developer inquiries, data feedback, or corrections</p>
              </div>
            </div>

            </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-canvas border border-hairline rounded-2xl p-8 shadow-sm">
          <form id="contact-form" class="space-y-6" action="https://formspree.io/f/xoeavbgo" method="POST">
            <div data-fs-success class="text-sm font-medium text-green-600"></div>
            <div data-fs-error class="text-sm font-medium text-red-600"></div>
            <input type="hidden" name="_subject" value="New message from Petrol Price India contact form" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-ink mb-2">Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  data-fs-field
                  class="w-full px-4 py-2.5 bg-canvas-soft border border-hairline rounded-lg focus:ring-2 focus:ring-ink/10 focus:border-ink outline-none transition-all text-sm"
                  placeholder="Your name"
                  required
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-2">Email</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  data-fs-field
                  class="w-full px-4 py-2.5 bg-canvas-soft border border-hairline rounded-lg focus:ring-2 focus:ring-ink/10 focus:border-ink outline-none transition-all text-sm"
                  placeholder="your@email.com"
                  required
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-ink mb-2">Subject</label>
              <select 
                id="subject" 
                name="subject" 
                data-fs-field
                class="w-full px-4 py-2.5 bg-canvas-soft border border-hairline rounded-lg focus:ring-2 focus:ring-ink/10 focus:border-ink outline-none transition-all text-sm appearance-none"
              >
                <option value="general">General Inquiry</option>
                <option value="data">Data Correction</option>
                <option value="feedback">Feedback/Suggestions</option>
                <option value="api">API Access</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-ink mb-2">Message</label>
              <textarea 
                id="message" 
                name="message" 
                data-fs-field
                rows="5" 
                class="w-full px-4 py-2.5 bg-canvas-soft border border-hairline rounded-lg focus:ring-2 focus:ring-ink/10 focus:border-ink outline-none transition-all text-sm"
                placeholder="How can we help you?"
                required
              ></textarea>
            </div>

            <button 
              type="submit" 
              data-fs-submit-btn
              class="w-full py-3 px-6 bg-ink text-canvas font-medium rounded-lg hover:bg-ink/90 transition-colors shadow-lg shadow-ink/10"
            >
              Send Message
            </button>
          </form>

          <script is:inline>
            window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
            formspree('initForm', { formElement: '#contact-form', formId: 'xoeavbgo' });
            // Prefill from ?subject= & ?message= (e.g. Report Issue links on city pages)
            (() => {
              try {
                const params = new URLSearchParams(window.location.search);
                const subject = params.get('subject');
                const message = params.get('message');
                if (subject) {
                  const sel = document.getElementById('subject');
                  if (sel && [...sel.options].some((o) => o.value === subject)) sel.value = subject;
                }
                if (message) {
                  const box = document.getElementById('message');
                  if (box && !box.value) box.value = message;
                }
              } catch (e) { /* ignore */ }
            })();
          </script>
          <script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Base>
