---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PriceCard from '../components/PriceCard.astro';
import { supabase } from '../lib/supabase';
import { formatDate, formatChange } from '../lib/utils';
import { buildCityInsights, computeNearbyComparison, highLow } from '../lib/insights';
import { Share2, Info, ChevronRight, MapPin, ArrowUpDown } from '@lucide/astro';

const { fuel, slug } = Astro.params;

if (!fuel || !slug) {
  Astro.response.status = 404;
}

// Only these fuels have real price columns. Anything else is a 404
// (prevents thin/empty pages like /foo-price-in-mumbai from indexing).
const ALLOWED_FUELS = ['petrol', 'diesel', 'cng', 'autogas'];
const isValidFuel = !!fuel && ALLOWED_FUELS.includes(fuel);
if (!isValidFuel) {
  Astro.response.status = 404;
}

const CITY_ALIASES = {
  'bangalore': 'bengaluru',
  'bombay': 'mumbai',
  'madras': 'chennai',
  'calcutta': 'kolkata',
  'trivandrum': 'thiruvananthapuram',
  'vizag': 'visakhapatnam',
  'pondicherry': 'puducherry',
  'banaras': 'varanasi',
  'benaras': 'varanasi',
  'gauhati': 'guwahati',
  'baroda': 'vadodara',
  'poona': 'pune',
  'cawnpore': 'kanpur',
  'belgaum': 'belagavi',
  'sholapur': 'solapur',
  'simla': 'shimla',
  'waltair': 'visakhapatnam'
};

const targetSlug = CITY_ALIASES[slug] || slug;

// Legacy slugs that no longer resolve to a live city or state page:
// - 'pondicherry' state slug was merged into 'puducherry'
// - Delhi localities that were never real cities but had live/indexed pages
// Redirect them (301) to their canonical page so old URLs don't become 404s.
const LEGACY_REDIRECTS: Record<string, string> = {
  'pondicherry': 'puducherry',
  'saket': 'delhi',
  'shahdara': 'delhi',
  'preet-vihar': 'delhi',
  'vasant-vihar': 'delhi',
  'rajouri-garden': 'delhi',
  'sadar-bazar': 'delhi',
  'kanjhawala': 'delhi',
};

const legacyRedirectTarget = LEGACY_REDIRECTS[slug] ?? LEGACY_REDIRECTS[targetSlug];
if (legacyRedirectTarget) {
  return Astro.redirect(`/${fuel}-price-in-${legacyRedirectTarget}`, 301);
}

// Check if slug is a city
const { data: city } = await supabase
  .from('cities')
  .select('*')
  .eq('city_slug', targetSlug)
  .single();

let type = null;
let stateName = null;
let stateSlug = null;

if (city) {
  type = 'city';
} else {
  // Check if slug is a state
  const { data: stateData } = await supabase
    .from('cities')
    .select('state_name, state_slug')
    .eq('state_slug', slug)
    .limit(1)
    .single();

  if (stateData) {
    type = 'state';
    stateName = stateData.state_name;
    stateSlug = stateData.state_slug;
  }
}

if (!type || !isValidFuel) {
  Astro.response.status = 404;
}

const today = new Date().toISOString().split('T')[0];

const fuelLabel = fuel === 'autogas' ? 'AutoGas' : fuel === 'cng' ? 'CNG' : fuel.charAt(0).toUpperCase() + fuel.slice(1);
const priceKey = `${fuel}_price`;
const changeKey = fuel === 'petrol' ? 'price_change' : `${fuel}_change`;

let title = "";
let description = "";
let faqSchema = null;
let pageSchema = null;
let cityInsights = [];
let highLowFaqText = "";
let nearbyFaqText = "";
let noindex = false;
let reportHref = "/contact";

// --- City Logic ---
let latestPrice, yesterdayPrice, priceHistory, nearbyPrices, nearbyCitiesList;
let hasPrice = false;
let priceNum: number | null = null;
let changeNum = 0;
let priceDate = today;
if (type === 'city' && isValidFuel) {
  const { data: priceData } = await supabase
    .from('prices')
    .select('*')
    .eq('city_id', city.id)
    .order('date', { ascending: false })
    .limit(31);

  latestPrice = priceData?.[0];
  yesterdayPrice = priceData?.[1];
  priceHistory = priceData || [];

  nearbyCitiesList = await supabase
    .from('cities')
    .select('*')
    .eq('state_name', city.state_name)
    .neq('id', city.id)
    .limit(6);

  // Compare neighbours on the same date as this page's own latest reading, not
  // on the server's UTC "today" — the scraper runs on IST and the UTC date can
  // be a day ahead, which previously returned zero rows and forced the
  // "not enough neighbouring data" fallback even for major cities.
  const nearbyDate = latestPrice?.date ?? today;
  const nearbyIds = nearbyCitiesList.data?.map(c => c.id) || [];
  let nbPrices = [];
  if (nearbyIds.length > 0) {
    const { data } = await supabase
      .from('prices')
      .select('*')
      .in('city_id', nearbyIds)
      .eq('date', nearbyDate);
    nbPrices = data || [];
  }
  nearbyPrices = nbPrices;

  // Only publish price figures that actually exist. When this fuel has no
  // recorded price for the city, fall back to copy without numbers so neither
  // the visible page nor the JSON-LD schema ever shows "XX.XX" placeholders.
  // NOTE: assigned to top-level `let`s (not `const`) so the template below can access them.
  hasPrice = latestPrice?.[priceKey] != null && Number(latestPrice[priceKey]) > 0;
  priceNum = hasPrice ? Number(latestPrice[priceKey]) : null;
  changeNum = latestPrice?.[changeKey] != null ? Number(latestPrice[changeKey]) : 0;
  // Display the date the price was actually recorded, not the server date —
  // otherwise a stale scrape prints "Today (8 Sept)" next to Sept-6 data.
  priceDate = latestPrice?.date ?? today;

  title = hasPrice
    ? `${fuelLabel} Price in ${city.city_name} Today (${formatDate(priceDate)}) — ₹${priceNum.toFixed(2)}/Litre`
    : `${fuelLabel} Price in ${city.city_name} — 30-Day History, Trends & Comparison`;
  description = hasPrice
    ? `Today's ${fuel} price in ${city.city_name} is ₹${priceNum.toFixed(2)} per litre (${changeNum >= 0 ? '+' : ''}${changeNum.toFixed(2)} from yesterday). Check 30-day price history, trends and fuel cost calculator for ${city.city_name}, ${city.state_name}.`
    : `Check ${fuel} price history, trends and fuel cost calculator for ${city.city_name}, ${city.state_name}. Updated for ${formatDate(priceDate)}.`;

  reportHref = `/contact?subject=data&message=${encodeURIComponent(`Issue with ${fuelLabel} price in ${city.city_name} (/${fuel}-price-in-${city.city_slug}/): `)}`;

  const insightCtx = {
    cityName: city.city_name,
    stateName: city.state_name,
    fuel,
    fuelLabel,
    priceKey,
    changeKey,
    unitLabel: 'per litre',
    latest: latestPrice,
    yesterday: yesterdayPrice,
    history: priceHistory,
    nearby: nearbyPrices || [],
  };

  cityInsights = buildCityInsights(insightCtx);

  highLowFaqText = (() => {
    const hl = highLow(priceHistory, priceKey);
    if (!hl) return `We don't have enough recorded history for ${city.city_name} yet to state a reliable 30-day high and low.`;
    if (hl.high === hl.low) return `In the last 30 days, the ${fuelLabel} price in ${city.city_name} has not moved, holding at ₹${hl.high.toFixed(2)} per litre the entire window.`;
    return `In the last 30 days, the highest ${fuelLabel} price in ${city.city_name} was ₹${hl.high.toFixed(2)} per litre and the lowest was ₹${hl.low.toFixed(2)} per litre.`;
  })();

  nearbyFaqText = (() => {
    const cmp = computeNearbyComparison(insightCtx);
    if (!cmp) return `There isn't enough neighbouring data synced yet to draw a fair comparison for ${city.city_name}. Check back tomorrow when the daily refresh has settled.`;
    const { price, cheapest, priciest, diff, hasMoreCities } = cmp;
    let text = diff > 0.05
      ? `Nearby, the cheapest ${fuelLabel} today is ${cheapest.city} at ₹${cheapest.p.toFixed(2)} per litre — filling up there instead of ${city.city_name} saves about ₹${diff.toFixed(2)} per litre (roughly ₹${(diff * 40).toFixed(2)} on a 40-litre tank).`
      : `Within a short drive of ${city.city_name}, prices are essentially level — the nearest city in our data comes in within a few paise of ₹${price.toFixed(2)} per litre.`;
    if (hasMoreCities && city.city_name !== priciest.city) {
      text += ` On the other end, ${priciest.city} is the highest-priced of the nearby cities at ₹${priciest.p.toFixed(2)} per litre.`;
    }
    return text;
  })();

  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      ...(hasPrice ? [
        {
          "@type": "Question",
          "name": `What is the ${fuelLabel} price in ${city.city_name} today?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The ${fuelLabel} price in ${city.city_name} today is ₹${priceNum.toFixed(2)} per litre.`
          }
        },
        {
          "@type": "Question",
          "name": `Is the ${fuel} price going up in ${city.city_name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `As of today, the ${fuel} price in ${city.city_name} is ₹${priceNum.toFixed(2)}. Recent trends show a ${changeNum > 0 ? 'rising' : 'fluctuating'} pattern depending on international crude rates.`
          }
        },
      ] : []),
      {
        "@type": "Question",
        "name": `Why is the ${fuel} price high in ${city.city_name}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `The price in ${city.city_name} is a combination of the base cost, central excise duty, and the state VAT of ${city.state_name}.`
        }
      },
      {
        "@type": "Question",
        "name": `At what time is the ${fuelLabel} price revised daily?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `The ${fuelLabel} price in ${city.city_name} is revised every morning at 6:00 AM IST.`
        }
      },
      {
        "@type": "Question",
        "name": `What was the highest and lowest ${fuelLabel} price in ${city.city_name} in the last 30 days?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": highLowFaqText
        }
      },
      {
        "@type": "Question",
        "name": `How does the ${fuelLabel} price in ${city.city_name} compare to nearby cities?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": nearbyFaqText
        }
      }
    ]
  };

  pageSchema = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": title,
        "description": description,
        "author": { "@type": "Organization", "name": "Petrol Price India" },
        "publisher": { "@type": "Organization", "name": "Petrol Price India" },
        "datePublished": today,
        "dateModified": today,
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": `https://petrolpriceindia.com/${fuel}-price-in-${city.city_slug}`
        },
        "hasPart": faqSchema
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://petrolpriceindia.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": city.state_name,
            "item": `https://petrolpriceindia.com/${fuel}-price-in-${city.state_slug}`
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": city.city_name
          }
        ]
      }
    ]
  };
}

// --- State Logic ---
let citiesInState, prices, avgPrice, maxPrice, minPrice;
if (type === 'state' && isValidFuel) {
  const { data: cis } = await supabase
    .from('cities')
    .select('*')
    .eq('state_name', stateName);
  citiesInState = cis;

  const cityIds = citiesInState?.map(c => c.id) || [];

  // Use the latest available price date, not the server's UTC "today".
  // The scraper runs on IST and can lag a day; filtering by UTC today
  // emptied every state page ("0 Cities", ₹N/A) whenever data was stale.
  let dataDate = today;
  if (cityIds.length > 0) {
    const { data: latestDateData } = await supabase
      .from('prices')
      .select('date')
      .in('city_id', cityIds)
      .order('date', { ascending: false })
      .limit(1);
    if (latestDateData?.[0]?.date) dataDate = latestDateData[0].date;
  }

  const { data: prs } = await supabase
    .from('prices')
    .select('*')
    .in('city_id', cityIds)
    .eq('date', dataDate)
    .order('city_name', { ascending: true });
  prices = prs;

  avgPrice = prices?.length 
    ? (prices.reduce((acc, curr) => acc + (curr[priceKey] || 0), 0) / prices.length).toFixed(2)
    : 'N/A';

  const sortedPrices = [...(prices || [])].sort((a, b) => (b[priceKey] || 0) - (a[priceKey] || 0));
  maxPrice = sortedPrices[0];
  minPrice = sortedPrices[sortedPrices.length - 1];

  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `What is the average ${fuelLabel} price in ${stateName} today?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `The average ${fuelLabel} price in ${stateName} today is ₹${avgPrice} per litre, based on ${prices?.length || 0} cities.`
        }
      },
      {
        "@type": "Question",
        "name": `Which city has the cheapest ${fuelLabel} in ${stateName}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `The cheapest ${fuelLabel} in ${stateName} today is ${minPrice?.city_name || 'N/A'} at ₹${minPrice?.[priceKey]?.toFixed(2) || 'N/A'} per litre.`
        }
      },
      {
        "@type": "Question",
        "name": `Which city has the highest ${fuelLabel} price in ${stateName}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `The highest ${fuelLabel} price in ${stateName} today is in ${maxPrice?.city_name || 'N/A'} at ₹${maxPrice?.[priceKey]?.toFixed(2) || 'N/A'} per litre.`
        }
      },
      {
        "@type": "Question",
        "name": `Why do ${fuel} prices vary across cities in ${stateName}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `Fuel prices vary across ${stateName} due to differences in local dealer commissions, transportation costs from depots, and municipal taxes or surcharges in each district.`
        }
      }
    ]
  };

  title = `${fuelLabel} Price in ${stateName} Today — Cities, Trends & Comparison`;
  description = `Check ${fuel} prices in all cities of ${stateName}. Find the cheapest city, state average, and daily price changes for ${stateName}. Updated for ${formatDate(dataDate)}.`;

  pageSchema = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://petrolpriceindia.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": stateName,
            "item": `https://petrolpriceindia.com/${fuel}-price-in-${stateSlug}`
          }
        ]
      },
      faqSchema
    ]
  };
}

// --- Indexing: petrol/diesel stay indexable; CNG/Autogas only when real data exists ---
// CNG and Autogas are not sold in most cities, so those pages would be empty
// templates. Keep them crawlable (follow) but out of the index until data exists.
if (!isValidFuel || !type) {
  noindex = true;
} else if (fuel === 'cng' || fuel === 'autogas') {
  if (type === 'city') {
    noindex = !(priceHistory || []).some((r) => r?.[priceKey] != null && Number(r[priceKey]) > 0);
  } else if (type === 'state') {
    noindex = !(prices || []).some((r) => r?.[priceKey] != null && Number(r[priceKey]) > 0);
  }
}
---

<Base title={title} description={description} noindex={noindex}>
  <Navbar />
  
  <main class="flex-1 bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      
      {/* City View */}
      {type === 'city' && isValidFuel && (
        <>
          <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8 overflow-x-auto whitespace-nowrap">
            <a href="/" class="hover:text-ink">Home</a>
            <ChevronRight class="w-3 h-3" />
            <a href={`/${fuel}-price-in-india/`} class="hover:text-ink">{fuelLabel} Price in India</a>
            <ChevronRight class="w-3 h-3" />
            <a href={`/${fuel}-price-in-${city.state_slug}`} class="hover:text-ink">{city.state_name}</a>
            <ChevronRight class="w-3 h-3" />
            <span class="text-ink">{city.city_name}</span>
          </nav>
          
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 min-w-0 space-y-8">
              <section>
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
                    {fuelLabel} Price in <span class="text-primary">{city.city_name}</span>
                  </h1>
                  <div class="flex gap-2">
                    <button id="shareBtn" type="button" aria-label="Share this page" title="Share this page" class="p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-colors cursor-pointer"><Share2 class="w-4 h-4 text-body pointer-events-none" /></button>
                    <a href={reportHref} class="flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-colors text-sm font-semibold"><Info class="w-4 h-4 text-body" /> Report Issue</a>
                    <span id="shareToast" role="status" class="hidden items-center px-3 py-2 rounded-full bg-ink text-canvas text-xs font-semibold">Link copied!</span>
                  </div>
                </div>
                <p class="text-sm text-body mb-6">
                  See <a href={`/${fuel}-price-in-india/`} class="font-semibold text-primary hover:underline">{fuelLabel} prices for all cities in India</a> for a full national overview.
                </p>
                <PriceCard 
                  city={city.city_name}
                  state={city.state_name}
                  price={latestPrice?.[priceKey] || 0}
                  change={latestPrice?.[changeKey] || 0}
                  lastUpdated={`${formatDate(latestPrice?.scraped_at || today)}`}
                  large={true}
                  slug={city.city_slug}
                  fuel={fuel}
                />
              </section>
              
              <section class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
                <h2 class="text-xl font-bold text-ink mb-6">30-Day {fuelLabel} Price Trend</h2>
                <div class="h-64 sm:h-80 w-full relative"><canvas id="priceChart" class="max-w-full"></canvas></div>
              </section>
              
{/* SEO Content Section */}
              <section class="bg-canvas border border-hairline rounded-xl p-8 shadow-sm">
                <article class="prose prose-neutral max-w-none">
                  {
                    cityInsights.map((section) => (
                      <div class="mb-6">
                        <h2 class="text-2xl font-bold text-ink mb-4">{section.heading}</h2>
                        {section.paragraphs.map((p) => (
                          <p class="text-body mb-3">{p}</p>
                        ))}
                      </div>
                    ))
                  }
                </article>
              </section>

              {/* Dynamic FAQ Section */}
              <section class="bg-canvas border border-hairline rounded-xl p-8 shadow-sm">
                <h2 class="text-2xl font-bold text-ink mb-6">Frequently Asked Questions — {city.city_name}</h2>
                <div class="space-y-6">
                  {hasPrice && (
                    <div class="border-b border-hairline pb-4 last:border-0">
                      <h3 class="text-base font-bold text-ink mb-2">What is the {fuelLabel} price in {city.city_name} today?</h3>
                      <p class="text-sm text-body">The current {fuelLabel} price in {city.city_name} is <strong>₹{priceNum.toFixed(2)}</strong> per litre as of {formatDate(priceDate)}.</p>
                    </div>
                  )}
                  {hasPrice && (
                    <div class="border-b border-hairline pb-4 last:border-0">
                      <h3 class="text-base font-bold text-ink mb-2">Is the {fuelLabel} price going up in {city.city_name}?</h3>
                      <p class="text-sm text-body">Today's price shows a change of <strong>{formatChange(latestPrice?.[changeKey])}</strong> compared to yesterday. Recent trends indicate a {changeNum > 0 ? 'rising' : 'stable'} market in {city.state_name}.</p>
                    </div>
                  )}
                  <div class="border-b border-hairline pb-4 last:border-0">
                    <h3 class="text-base font-bold text-ink mb-2">Why is {fuelLabel} expensive in {city.city_name}?</h3>
                    <p class="text-sm text-body">The retail price in {city.city_name} includes central excise duty, dealer commissions, and the state-level VAT specific to {city.state_name}.</p>
                  </div>
                  <div class="border-b border-hairline pb-4 last:border-0">
                    <h3 class="text-base font-bold text-ink mb-2">When is the {fuelLabel} rate updated?</h3>
                    <p class="text-sm text-body">Fuel rates in {city.city_name} are updated daily at 6:00 AM IST by Oil Marketing Companies (OMCs) like IOC, HPCL, and BPCL.</p>
                  </div>
                  <div class="border-b border-hairline pb-4 last:border-0">
                    <h3 class="text-base font-bold text-ink mb-2">What was the highest and lowest {fuelLabel} price in {city.city_name} in the last 30 days?</h3>
                    <p class="text-sm text-body">{highLowFaqText}</p>
                  </div>
                  <div class="border-b border-hairline pb-4 last:border-0">
                    <h3 class="text-base font-bold text-ink mb-2">How does the {fuelLabel} price in {city.city_name} compare to nearby cities?</h3>
                    <p class="text-sm text-body">{nearbyFaqText}</p>
                  </div>
                </div>
              </section>

              <section class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
                <div class="px-6 py-4 border-b border-hairline flex justify-between items-center bg-canvas">
                  <h2 class="text-xl font-bold text-ink">Price History</h2>
                  <span class="text-xs font-mono text-mute uppercase tracking-widest">Last 30 Days</span>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full text-left">
                    <thead class="bg-canvas-soft-2 text-[10px] font-mono uppercase tracking-widest text-mute">
                      <tr><th class="px-6 py-3">Date</th><th class="px-6 py-3 text-right">Price (₹/L)</th><th class="px-6 py-3 text-right">Change</th></tr>
                    </thead>
                    <tbody class="divide-y divide-hairline">
                      {priceHistory.map((item) => (
                        <tr class="hover:bg-canvas-soft transition-colors">
                          <td class="px-6 py-4 text-sm font-medium">{formatDate(item.date)}</td>
                          <td class="px-6 py-4 text-sm font-mono font-bold text-right">₹{item[priceKey]?.toFixed(2) || 'N/A'}</td>
                          <td class={`px-6 py-4 text-sm font-mono text-right ${item[changeKey] > 0 ? 'text-error' : item[changeKey] < 0 ? 'text-success' : 'text-mute'}`}>
                            {formatChange(item[changeKey])}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            </div>
            
            <div class="min-w-0 space-y-8">
              <div class="bg-primary rounded-xl p-8 text-canvas shadow-lg">
                <h3 class="text-lg font-semibold mb-6">Market Insight</h3>
                <div class="space-y-6">
                  <div><p class="text-xs text-canvas/60 uppercase tracking-widest mb-1">Yesterday's Price</p><p class="text-2xl font-bold">₹{yesterdayPrice?.[priceKey]?.toFixed(2) || 'N/A'}</p></div>
                  <div class="pt-6 border-t border-canvas/10">
                    <p class="text-xs text-canvas/60 uppercase tracking-widest mb-1">30-Day High</p>
                    <p class="text-2xl font-bold">₹{priceHistory.length > 0 ? Math.max(...priceHistory.map(p => p[priceKey] || 0)).toFixed(2) : 'N/A'}</p>
                  </div>
                  <div class="pt-6 border-t border-canvas/10">
                    <p class="text-xs text-canvas/60 uppercase tracking-widest mb-1">30-Day Low</p>
                    <p class="text-2xl font-bold">₹{priceHistory.length > 0 ? Math.min(...priceHistory.map(p => p[priceKey] || Infinity)).toFixed(2) : 'N/A'}</p>
                  </div>
                </div>
              </div>
              <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 mb-6"><MapPin class="w-4 h-4 text-mute" /><h2 class="text-sm font-bold uppercase tracking-wider text-mute">Nearby Cities</h2></div>
                <div class="space-y-4">
                  {nearbyPrices?.map(item => {
                    const city = nearbyCitiesList.data?.find(c => c.id === item.city_id);
                    if (!city) return null;
                    return (
                      <a href={`/${fuel}-price-in-${city.city_slug}`} class="flex justify-between items-center group">
                        <span class="text-sm font-medium group-hover:text-primary transition-colors">{item.city_name}</span>
                        <div class="text-right">
                          <p class="text-sm font-mono font-bold">₹{item[priceKey]?.toFixed(2) || 'N/A'}</p>
                          <p class={`text-[10px] font-mono ${item[changeKey] > 0 ? 'text-error' : item[changeKey] < 0 ? 'text-success' : 'text-mute'}`}>
                            {item[changeKey] > 0 ? '▲' : item[changeKey] < 0 ? '▼' : ''} {Math.abs(item[changeKey] || 0).toFixed(2)}
                          </p>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>

              {/* Calculator CTA */}
              <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-8 text-center">
                <h3 class="font-bold text-lg mb-2">Save on Fuel?</h3>
                <p class="text-sm text-body mb-6">Use our calculator to estimate your trip cost and find the cheapest fuel nearby.</p>
                <a href="/calculator" class="inline-block w-full bg-primary text-canvas py-3 rounded-full text-sm font-semibold hover:bg-ink transition-colors">
                  Try Fuel Calculator
                </a>
              </div>
            </div>
          </div>
          <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
          <script is:inline define:vars={{ priceHistory, priceKey, fuelLabel }}>
            const ctx = document.getElementById('priceChart');
            if (ctx && priceHistory && priceHistory.length > 0) {
              const validData = [...priceHistory]
                .filter(p => p[priceKey] !== null && p[priceKey] !== undefined)
                .reverse();

              new Chart(ctx, {
                type: 'line',
                data: {
                  labels: validData.map(p => new Date(p.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })),
                  datasets: [{
                    label: `${fuelLabel} Price (₹/L)`,
                    data: validData.map(p => p[priceKey]),
                    borderColor: '#171717',
                    backgroundColor: 'rgba(23, 23, 23, 0.05)',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#171717',
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: '#171717',
                    pointHoverBorderColor: '#fff',
                    pointHoverBorderWidth: 2,
                  }]
                },
                options: { 
                  responsive: true, 
                  maintainAspectRatio: false, 
                  interaction: {
                    mode: 'index',
                    intersect: false,
                  },
                  plugins: { 
                    legend: { display: false },
                    tooltip: {
                      backgroundColor: '#171717',
                      titleColor: '#fff',
                      bodyColor: '#fff',
                      padding: 12,
                      cornerRadius: 8,
                      callbacks: {
                        label: function(context) {
                          return ` ${fuelLabel} Price: ₹${context.parsed.y.toFixed(2)}`;
                        }
                      }
                    }
                  },
                  scales: {
                    y: {
                      beginAtZero: false,
                      grace: '10%',
                      ticks: {
                        font: { size: 11 },
                        callback: function(value) {
                          return '₹' + value.toFixed(1);
                        }
                      },
                      grid: {
                        color: 'rgba(0, 0, 0, 0.05)',
                      }
                    },
                    x: {
                      ticks: {
                        font: { size: 11 },
                        maxRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 7
                      },
                      grid: {
                        display: false
                      }
                    }
                  }
                }
              });
            }
          </script>
          <script is:inline>
            (() => {
              const btn = document.getElementById('shareBtn');
              const toast = document.getElementById('shareToast');
              if (!btn) return;
              const showToast = (msg) => {
                if (!toast) return;
                toast.textContent = msg;
                toast.classList.remove('hidden');
                toast.classList.add('inline-flex');
                window.clearTimeout(window.__shareToastT);
                window.__shareToastT = window.setTimeout(() => {
                  toast.classList.add('hidden');
                  toast.classList.remove('inline-flex');
                }, 2000);
              };
              btn.addEventListener('click', async () => {
                const url = window.location.href;
                const shareTitle = document.title;
                const text = shareTitle;
                if (navigator.share) {
                  try {
                    await navigator.share({ title: shareTitle, text, url });
                  } catch (e) {
                    // user dismissed — ignore
                  }
                  return;
                }
                try {
                  await navigator.clipboard.writeText(url);
                  showToast('Link copied!');
                } catch (e) {
                  // Last-resort fallback for old browsers
                  const ta = document.createElement('textarea');
                  ta.value = url;
                  document.body.appendChild(ta);
                  ta.select();
                  try {
                    document.execCommand('copy');
                    showToast('Link copied!');
                  } catch (_e) {
                    showToast('Copy this URL: ' + url);
                  }
                  ta.remove();
                }
              });
            })();
          </script>
        </>
      )}

      {/* Not Found */}
      {(!type || !isValidFuel) && (
        <div class="flex items-center justify-center py-20 px-4">
          <div class="max-w-md w-full text-center">
            <h1 class="text-8xl sm:text-9xl lg:text-[12rem] font-bold leading-none text-ink/5 select-none">404</h1>
            <h2 class="text-3xl font-bold mb-4">City or state not found</h2>
            <p class="text-body mb-10 text-lg">
              We couldn't find fuel price data for "{slug}". It might be misspelled or not yet in our database.
            </p>
            <a href="/all-cities" class="inline-flex items-center justify-center gap-2 bg-ink text-canvas px-8 py-3 rounded-xl font-semibold hover:opacity-90 transition-all">
              Browse All Cities
            </a>
          </div>
        </div>
      )}

      {/* State View */}
      {type === 'state' && isValidFuel && (
        <>
          <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8">
            <a href="/" class="hover:text-ink">Home</a>
            <ChevronRight class="w-3 h-3" />
            <a href={`/${fuel}-price-in-india/`} class="hover:text-ink">{fuelLabel} Price in India</a>
            <ChevronRight class="w-3 h-3" />
            <span class="text-ink">{stateName}</span>
          </nav>
          <header class="mb-12">
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink mb-4">{fuelLabel} Price in <span class="text-primary">{stateName}</span></h1>
            <p class="text-lg text-body max-w-2xl">Daily updated {fuel} prices for all major cities and districts in {stateName}.</p>
            <p class="text-sm text-body mt-4">
              See <a href={`/${fuel}-price-in-india/`} class="font-semibold text-primary hover:underline">{fuelLabel} prices for all states in India</a> for a full national overview.
            </p>
          </header>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
            <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm"><p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">State Average</p><p class="text-3xl font-bold text-ink">₹{avgPrice}<span class="text-sm font-normal text-mute ml-1">/L</span></p></div>
            <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm border-l-4 border-l-error"><p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">Highest Price</p><p class="text-3xl font-bold text-ink">₹{maxPrice?.[priceKey]?.toFixed(2) || 'N/A'}</p><p class="text-xs text-body mt-1">in {maxPrice?.city_name}</p></div>
            <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm border-l-4 border-l-success"><p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">Lowest Price</p><p class="text-3xl font-bold text-ink">₹{minPrice?.[priceKey]?.toFixed(2) || 'N/A'}</p><p class="text-xs text-body mt-1">in {minPrice?.city_name}</p></div>
          </div>
          <section class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 border-b border-hairline flex justify-between items-center bg-canvas">
              <h2 class="text-xl font-bold text-ink">Cities in {stateName}</h2>
              <span class="text-xs font-mono text-mute uppercase tracking-widest">{prices?.length || 0} Cities</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-canvas-soft-2 text-[10px] font-mono uppercase tracking-widest text-mute">
                  <tr><th class="px-6 py-4">City</th><th class="px-6 py-4 text-right">Price (₹/L)</th><th class="px-6 py-4 text-right">Change</th><th class="px-6 py-4"></th></tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                  {prices?.map((item) => (
                    <tr class="hover:bg-canvas-soft transition-colors group">
                      <td class="px-6 py-4"><p class="text-sm font-semibold text-ink">{item.city_name}</p></td>
                      <td class="px-6 py-4 text-sm font-mono font-bold text-right">₹{item[priceKey]?.toFixed(2) || 'N/A'}</td>
                      <td class={`px-6 py-4 text-sm font-mono text-right ${item[changeKey] > 0 ? 'text-error' : item[changeKey] < 0 ? 'text-success' : 'text-mute'}`}>
                        {item[changeKey] > 0 ? '▲' : item[changeKey] < 0 ? '▼' : '—'} {Math.abs(item[changeKey] || 0).toFixed(2)}
                      </td>
                      <td class="px-6 py-4 text-right"><a href={`/${fuel}-price-in-${citiesInState?.find(c => c.id === item.city_id)?.city_slug}`} class="inline-flex items-center gap-1 text-xs font-semibold text-mute group-hover:text-primary transition-colors">View Details <ChevronRight class="w-3 h-3" /></a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </>
      )}
    </div>
  </main>
  
  <Footer />
  {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
</Base>
