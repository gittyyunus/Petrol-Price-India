---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Database, Clock, Calculator, ShieldCheck, HelpCircle, ChevronRight, AlertCircle, FileText } from '@lucide/astro';

const title = "Data Sources & Pricing Methodology — Petrol Price India";
const description = "Transparent breakdown of our fuel data sources (OMCs, PPAC, MoPNG), 6:00 AM dynamic daily revision schedule, price buildup formula, and correction policy.";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://petrolpriceindia.com/methodology",
      "url": "https://petrolpriceindia.com/methodology",
      "name": title,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Petrol Price India",
        "url": "https://petrolpriceindia.com"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://petrolpriceindia.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Methodology & Data Sources"
        }
      ]
    }
  ]
};
---

<Base title={title} description={description}>
  <Navbar />
  
  <main class="flex-1 bg-canvas-soft">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-ink">Home</a>
        <ChevronRight class="w-3 h-3" />
        <span class="text-ink">Methodology & Data Sources</span>
      </nav>

      <header class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-mono uppercase tracking-widest text-primary mb-4">
          <Database class="w-3.5 h-3.5" /> Data Transparency & E-E-A-T
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink mb-4">
          Data Sources & Pricing Methodology
        </h1>
        <p class="text-lg text-body leading-relaxed">
          At Petrol Price India, our mission is to deliver dependable, timely, and transparent retail fuel pricing across 500+ Indian cities and districts. Here is an exhaustive breakdown of where our data originates, how price changes are calculated, and how we audit accuracy.
        </p>
      </header>

      <div class="space-y-12">
        <!-- Section 1: Primary Data Sources -->
        <section class="bg-canvas border border-hairline rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="p-2.5 rounded-xl bg-primary/10 text-primary">
              <Database class="w-5 h-5" />
            </span>
            <h2 class="text-2xl font-bold text-ink">1. Primary Data Sources</h2>
          </div>
          <div class="prose prose-neutral max-w-none text-body space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
              Fuel pricing in India is deregulated and determined through state-run and private energy distributors. We collect raw price statements and forecourt notifications from official public disclosures, including:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>
                <strong class="text-ink">Public Sector Oil Marketing Companies (OMCs):</strong> The primary retail fuel suppliers in India — Indian Oil Corporation Limited (IOCL), Bharat Petroleum Corporation Limited (BPCL), and Hindustan Petroleum Corporation Limited (HPCL).
              </li>
              <li>
                <strong class="text-ink">Petroleum Planning & Analysis Cell (PPAC):</strong> An attached office of the Ministry of Petroleum & Natural Gas (MoPNG), Government of India, which publishes historical crude indices, central excise statements, and state-wise sales tax (VAT) schedules.
              </li>
              <li>
                <strong class="text-ink">City Gas Distribution (CGD) Companies:</strong> For Compressed Natural Gas (CNG), prices are sourced from authorized regional distributors licensed by the Petroleum and Natural Gas Regulatory Board (PNGRB), including Indraprastha Gas Ltd (IGL), Mahanagar Gas Ltd (MGL), Gujarat Gas Ltd, Adani Total Gas, GAIL Gas Ltd, and Torrent Gas.
              </li>
              <li>
                <strong class="text-ink">International Benchmarks (AutoGas):</strong> Automotive LPG rates are tied to monthly Saudi Aramco contract prices (CP) for propane and butane, published in conjunction with OMC monthly tariff notices.
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Revision Schedule -->
        <section class="bg-canvas border border-hairline rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="p-2.5 rounded-xl bg-primary/10 text-primary">
              <Clock class="w-5 h-5" />
            </span>
            <h2 class="text-2xl font-bold text-ink">2. Daily Revision Timing</h2>
          </div>
          <div class="prose prose-neutral max-w-none text-body space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
              Under the <strong>Dynamic Fuel Pricing Scheme</strong> implemented nationwide on June 16, 2017, petrol and diesel retail rates are revised daily at <strong>6:00 AM IST</strong>.
            </p>
            <p>
              Our automated data collection pipelines query distributor feeds every morning between 6:00 AM and 6:30 AM IST. While international crude oil trades 24/7 on global exchanges, pump rates remain fixed for 24 hours between consecutive 6:00 AM revision cycles.
            </p>
            <div class="bg-canvas-soft-2/50 border border-hairline rounded-xl p-4 text-xs font-mono text-mute">
              Daily Scrape Schedule: 06:05 AM IST daily • Primary sync window: 06:00 - 06:45 AM IST • Secondary audit sweep: 12:00 PM IST
            </div>
          </div>
        </section>

        <!-- Section 3: Price Buildup Formula -->
        <section class="bg-canvas border border-hairline rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="p-2.5 rounded-xl bg-primary/10 text-primary">
              <Calculator class="w-5 h-5" />
            </span>
            <h2 class="text-2xl font-bold text-ink">3. Retail Price Buildup Architecture</h2>
          </div>
          <div class="prose prose-neutral max-w-none text-body space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
              The retail selling price (RSP) at any pump in India is computed from five distinct structural components:
            </p>
            <div class="grid sm:grid-cols-2 gap-4 my-4">
              <div class="border border-hairline rounded-xl p-4 bg-canvas-soft-2/30">
                <h4 class="font-bold text-ink text-sm mb-1">1. Base Refinery Price</h4>
                <p class="text-xs text-mute">Reflects international crude import parity price (IPP) and refinery margin.</p>
              </div>
              <div class="border border-hairline rounded-xl p-4 bg-canvas-soft-2/30">
                <h4 class="font-bold text-ink text-sm mb-1">2. Central Excise Duty</h4>
                <p class="text-xs text-mute">Uniform nationwide duty levied by the Central Government (Union Ministry of Finance).</p>
              </div>
              <div class="border border-hairline rounded-xl p-4 bg-canvas-soft-2/30">
                <h4 class="font-bold text-ink text-sm mb-1">3. Dealer Commission</h4>
                <p class="text-xs text-mute">Fixed fee paid to petrol pump franchise dealers for forecourt handling and vapor loss.</p>
              </div>
              <div class="border border-hairline rounded-xl p-4 bg-canvas-soft-2/30">
                <h4 class="font-bold text-ink text-sm mb-1">4. State VAT & Local Cess</h4>
                <p class="text-xs text-mute">Ad-valorem sales tax set independently by each state (ranges from 1% to over 30%).</p>
              </div>
            </div>
            <p class="text-sm">
              Because state VAT is applied <em>ad-valorem</em> on the sum of base price, excise duty, and dealer commission, any change in international crude is magnified in high-VAT states (such as Maharashtra, Andhra Pradesh, and Telangana) compared to low-tax jurisdictions (such as Andaman or Delhi).
            </p>
          </div>
        </section>

        <!-- Section 4: Units & Measurement Standards -->
        <section class="bg-canvas border border-hairline rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="p-2.5 rounded-xl bg-primary/10 text-primary">
              <FileText class="w-5 h-5" />
            </span>
            <h2 class="text-2xl font-bold text-ink">4. Fuel Measurement & Unit Standards</h2>
          </div>
          <div class="prose prose-neutral max-w-none text-body space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
              To ensure factual and regulatory compliance:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong class="text-ink">Petrol (Motor Spirit / MS):</strong> Sold and quoted per <strong>Litre (₹/L)</strong>.</li>
              <li><strong class="text-ink">High-Speed Diesel (HSD):</strong> Sold and quoted per <strong>Litre (₹/L)</strong>.</li>
              <li><strong class="text-ink">Compressed Natural Gas (CNG):</strong> Sold and quoted by weight in <strong>Kilograms (₹/kg)</strong>. CNG is compressed to ~200 bar and dispensed by mass, never by volume.</li>
              <li><strong class="text-ink">AutoGas (Automotive LPG):</strong> Sold and quoted per <strong>Litre (₹/L)</strong> at automotive dispensing stations.</li>
            </ul>
          </div>
        </section>

        <!-- Section 5: Verification & Correction Policy -->
        <section class="bg-canvas border border-hairline rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="p-2.5 rounded-xl bg-primary/10 text-primary">
              <ShieldCheck class="w-5 h-5" />
            </span>
            <h2 class="text-2xl font-bold text-ink">5. Quality Control & Correction Policy</h2>
          </div>
          <div class="prose prose-neutral max-w-none text-body space-y-4 text-sm sm:text-base leading-relaxed">
            <p>
              We run automated anomaly detection tests during every ingest cycle:
            </p>
            <ul class="list-disc pl-5 space-y-1">
              <li>Price changes greater than ₹5.00 in a single session trigger manual editorial verification before display.</li>
              <li>Missing prices for individual fuels (e.g. towns without CNG infrastructure) are explicitly flagged and excluded from indexable search results.</li>
              <li>Historical continuity checks prevent reporting false highs or lows across temporary data gaps.</li>
            </ul>
            <div class="mt-6 p-4 rounded-xl border border-hairline bg-canvas-soft-2/40 flex items-start gap-3">
              <AlertCircle class="w-5 h-5 text-primary shrink-0 mt-0.5" />
              <div class="text-sm">
                <p class="font-bold text-ink">Notice a forecourt discrepancy?</p>
                <p class="text-mute mt-1">
                  Individual bunk operators may occasionally apply micro-freight differences. If you spot a divergence between our reported rate and your local pump board, please report it via our <a href="/contact?subject=data" class="font-semibold text-primary hover:underline">Data Correction Channel</a>. Corrections are investigated within 24 hours.
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
  
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
</Base>

