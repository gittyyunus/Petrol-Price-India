---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PriceCard from '../components/PriceCard.astro';
import { supabase } from '../lib/supabase';
import { formatDate, formatChange } from '../lib/utils';
import { ArrowLeft, Share2, Info, ChevronRight, MapPin } from '@lucide/astro';

export async function getStaticPaths() {
  const { data: cities } = await supabase.from('cities').select('*');
  
  return cities?.map((city) => ({
    params: { city: city.city_slug },
    props: { city },
  })) || [];
}

const { city } = Astro.props;
const today = new Date().toISOString().split('T')[0];

// Fetch today's price
const { data: priceData } = await supabase
  .from('prices')
  .select('*')
  .eq('city_id', city.id)
  .order('date', { ascending: false })
  .limit(31);

const latestPrice = priceData?.[0];
const yesterdayPrice = priceData?.[1];

const priceHistory = priceData || [];
const nearbyCities = await supabase
  .from('cities')
  .select('*')
  .eq('state_name', city.state_name)
  .neq('id', city.id)
  .limit(6);

// Nearby cities prices
const { data: nearbyPrices } = await supabase
  .from('prices')
  .select('*')
  .in('city_id', nearbyCities.data?.map(c => c.id) || [])
  .eq('date', today);

const title = `Petrol Price in ${city.city_name} Today (${formatDate(today)}) — ₹${latestPrice?.petrol_price || 'XX.XX'}/Litre`;
const description = `Today's petrol price in ${city.city_name} is ₹${latestPrice?.petrol_price || 'XX.XX'} per litre (${latestPrice?.price_change >= 0 ? '+' : ''}${latestPrice?.price_change || '0.00'} from yesterday). Check 30-day price history, trends and fuel cost calculator for ${city.city_name}, ${city.state_name}.`;

// JSON-LD FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the petrol price in ${city.city_name} today?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The petrol price in ${city.city_name} today is ₹${latestPrice?.petrol_price || 'XX.XX'} per litre.`
      }
    },
    {
      "@type": "Question",
      "name": `Was there a price change in ${city.city_name} petrol price today?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": latestPrice?.price_change === 0 
          ? `No, the petrol price in ${city.city_name} remained unchanged today.`
          : `Yes, the petrol price in ${city.city_name} changed by ₹${latestPrice?.price_change} compared to yesterday.`
      }
    }
  ]
};
---

<Base title={title} description={description}>
  <Navbar />
  
  <main class="flex-1 bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      {/* Breadcrumbs */}
      <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-ink">Home</a>
        <ChevronRight class="w-3 h-3" />
        <a href={`/petrol-price-in-${city.state_slug}`} class="hover:text-ink">{city.state_name}</a>
        <ChevronRight class="w-3 h-3" />
        <span class="text-ink">{city.city_name}</span>
      </nav>
      
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          {/* Main Price Card */}
          <section>
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
              <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
                Petrol Price in <span class="text-primary">{city.city_name}</span>
              </h1>
              <div class="flex gap-2">
                <button class="p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-colors">
                  <Share2 class="w-4 h-4 text-body" />
                </button>
                <button class="flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-colors text-sm font-semibold">
                  <Info class="w-4 h-4 text-body" />
                  Report Issue
                </button>
              </div>
            </div>
            
            <PriceCard 
              city={city.city_name}
              state={city.state_name}
              price={latestPrice?.petrol_price || 0}
              change={latestPrice?.price_change || 0}
              lastUpdated={`${formatDate(latestPrice?.scraped_at || today)}`}
              large={true}
            />
          </section>
          
          {/* Chart Section */}
          <section class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
            <h2 class="text-xl font-bold text-ink mb-6">30-Day Price Trend</h2>
            <div class="h-64 sm:h-80 w-full relative">
              <canvas id="priceChart"></canvas>
            </div>
          </section>
          
          {/* History Table */}
          <section class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 border-b border-hairline flex justify-between items-center">
              <h2 class="text-xl font-bold text-ink">Price History</h2>
              <span class="text-xs font-mono text-mute uppercase tracking-widest">Last 30 Days</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-canvas-soft-2 text-[10px] font-mono uppercase tracking-widest text-mute">
                  <tr>
                    <th class="px-6 py-3">Date</th>
                    <th class="px-6 py-3 text-right">Price (₹/L)</th>
                    <th class="px-6 py-3 text-right">Change</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                  {priceHistory.map((item) => (
                    <tr class="hover:bg-canvas-soft transition-colors">
                      <td class="px-6 py-4 text-sm font-medium">{formatDate(item.date)}</td>
                      <td class="px-6 py-4 text-sm font-mono font-bold text-right">₹{item.petrol_price?.toFixed(2) || 'N/A'}</td>
                      <td class={`px-6 py-4 text-sm font-mono text-right ${item.price_change > 0 ? 'text-error' : item.price_change < 0 ? 'text-success' : 'text-mute'}`}>
                        {formatChange(item.price_change)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </div>
        
        {/* Sidebar */}
        <div class="space-y-8">
          {/* Stats Card */}
          <div class="bg-primary rounded-xl p-8 text-canvas shadow-lg">
            <h3 class="text-lg font-semibold mb-6">Market Insight</h3>
            <div class="space-y-6">
              <div>
                <p class="text-xs text-canvas/60 uppercase tracking-widest mb-1">Yesterday's Price</p>
                <p class="text-2xl font-bold">₹{yesterdayPrice?.petrol_price?.toFixed(2) || 'N/A'}</p>
              </div>
              <div class="pt-6 border-t border-canvas/10">
                <p class="text-xs text-canvas/60 uppercase tracking-widest mb-1">30-Day High</p>
                <p class="text-2xl font-bold">₹{Math.max(...priceHistory.map(p => p.petrol_price || 0)).toFixed(2) || 'N/A'}</p>
              </div>
              <div class="pt-6 border-t border-canvas/10">
                <p class="text-xs text-canvas/60 uppercase tracking-widest mb-1">30-Day Low</p>
                <p class="text-2xl font-bold">₹{(Math.min(...priceHistory.map(p => p.petrol_price || Infinity)) === Infinity ? 0 : Math.min(...priceHistory.map(p => p.petrol_price || Infinity))).toFixed(2) || 'N/A'}</p>
              </div>
            </div>
          </div>
          
          {/* Nearby Cities */}
          <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
            <div class="flex items-center gap-2 mb-6">
              <MapPin class="w-4 h-4 text-mute" />
              <h2 class="text-sm font-bold uppercase tracking-wider text-mute">Nearby Cities</h2>
            </div>
            <div class="space-y-4">
              {nearbyPrices?.map(item => (
                <a href={`/petrol-price-in-${nearbyCities.data?.find(c => c.id === item.city_id)?.city_slug}`} class="flex justify-between items-center group">
                  <span class="text-sm font-medium group-hover:text-primary transition-colors">{item.city_name}</span>
                  <div class="text-right">
                    <p class="text-sm font-mono font-bold">₹{item.petrol_price?.toFixed(2) || 'N/A'}</p>
                    <p class={`text-[10px] font-mono ${item.price_change > 0 ? 'text-error' : item.price_change < 0 ? 'text-success' : 'text-mute'}`}>
                      {item.price_change > 0 ? '▲' : item.price_change < 0 ? '▼' : ''} {Math.abs(item.price_change || 0).toFixed(2)}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
          
          {/* Calculator CTA */}
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-8 text-center">
            <h3 class="font-bold text-lg mb-2">Save on Fuel?</h3>
            <p class="text-sm text-body mb-6">Use our calculator to estimate your trip cost and find the cheapest fuel nearby.</p>
            <a href="/calculator" class="inline-block w-full bg-primary text-canvas py-3 rounded-full text-sm font-semibold hover:bg-ink transition-colors">
              Try Fuel Calculator
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
  
  {/* JSON-LD FAQ */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline define:vars={{ priceHistory }}>
    const ctx = document.getElementById('priceChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: priceHistory.map(p => new Date(p.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })).reverse(),
          datasets: [{
            label: 'Petrol Price (₹/L)',
            data: priceHistory.map(p => p.petrol_price).reverse(),
            borderColor: '#171717',
            backgroundColor: 'rgba(23, 23, 23, 0.05)',
            borderWidth: 2,
            tension: 0.3,
            fill: true,
            pointRadius: 3,
            pointBackgroundColor: '#171717',
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#171717',
              titleFont: { family: 'Geist' },
              bodyFont: { family: 'Geist' },
              padding: 12,
              displayColors: false,
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { font: { size: 10, family: 'Geist Mono' } }
            },
            y: {
              grid: { color: '#ebebeb' },
              ticks: { font: { size: 10, family: 'Geist Mono' } }
            }
          }
        }
      });
    }
  </script>
</Base>
