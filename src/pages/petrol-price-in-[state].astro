---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';
import { formatDate } from '../lib/utils';
import { ChevronRight, ArrowUpDown } from '@lucide/astro';

export async function getStaticPaths() {
  const { data: cities } = await supabase.from('cities').select('state_name, state_slug');
  
  // Get unique states
  const states = Array.from(new Set(cities?.map(c => JSON.stringify({ name: c.state_name, slug: c.state_slug }))));
  
  return states.map((s) => {
    const state = JSON.parse(s);
    return {
      params: { state: state.slug },
      props: { stateName: state.name, stateSlug: state.slug },
    };
  });
}

const { stateName, stateSlug } = Astro.props;
const today = new Date().toISOString().split('T')[0];

// Fetch all cities in this state
const { data: citiesInState } = await supabase
  .from('cities')
  .select('*')
  .eq('state_name', stateName);

const cityIds = citiesInState?.map(c => c.id) || [];

// Fetch prices for all cities in the state for today
const { data: prices } = await supabase
  .from('prices')
  .select('*')
  .in('city_id', cityIds)
  .eq('date', today)
  .order('city_name', { ascending: true });

const avgPrice = prices?.length 
  ? (prices.reduce((acc, curr) => acc + (curr.petrol_price || 0), 0) / prices.length).toFixed(2)
  : 'N/A';

const sortedPrices = [...(prices || [])].sort((a, b) => (b.petrol_price || 0) - (a.petrol_price || 0));
const maxPrice = sortedPrices[0];
const minPrice = sortedPrices[sortedPrices.length - 1];

const title = `Petrol Price in ${stateName} Today — Cities, Trends & Comparison`;
const description = `Check petrol prices in all cities of ${stateName}. Find the cheapest city, state average, and daily price changes for ${stateName}. Updated for ${formatDate(today)}.`;
---

<Base title={title} description={description}>
  <Navbar />
  
  <main class="flex-1 bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      {/* Breadcrumbs */}
      <nav class="flex items-center gap-2 text-xs font-medium text-mute mb-8">
        <a href="/" class="hover:text-ink">Home</a>
        <ChevronRight class="w-3 h-3" />
        <span class="text-ink">{stateName}</span>
      </nav>
      
      <header class="mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink mb-4">
          Petrol Price in <span class="text-primary">{stateName}</span>
        </h1>
        <p class="text-lg text-body max-w-2xl">
          Daily updated petrol prices for all major cities and districts in {stateName}.
        </p>
      </header>
      
      {/* State Stats */}
      <div class="grid sm:grid-cols-3 gap-6 mb-12">
        <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
          <p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">State Average</p>
          <p class="text-3xl font-bold text-ink">₹{avgPrice}<span class="text-sm font-normal text-mute ml-1">/L</span></p>
        </div>
        <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm border-l-4 border-l-error">
          <p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">Highest Price</p>
          <p class="text-3xl font-bold text-ink">₹{maxPrice?.petrol_price?.toFixed(2) || 'N/A'}</p>
          <p class="text-xs text-body mt-1">in {maxPrice?.city_name}</p>
        </div>
        <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm border-l-4 border-l-success">
          <p class="text-xs text-mute font-mono uppercase tracking-widest mb-1">Lowest Price</p>
          <p class="text-3xl font-bold text-ink">₹{minPrice?.petrol_price?.toFixed(2) || 'N/A'}</p>
          <p class="text-xs text-body mt-1">in {minPrice?.city_name}</p>
        </div>
      </div>
      
      {/* Cities Table */}
      <section class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-hairline flex justify-between items-center bg-canvas">
          <h2 class="text-xl font-bold text-ink">Cities in {stateName}</h2>
          <span class="text-xs font-mono text-mute uppercase tracking-widest">{prices?.length || 0} Cities</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left" id="state-cities-table">
            <thead class="bg-canvas-soft-2 text-[10px] font-mono uppercase tracking-widest text-mute">
              <tr>
                <th class="px-6 py-4 cursor-pointer hover:text-ink transition-colors" data-sort="city">
                  <div class="flex items-center gap-1">City <ArrowUpDown class="w-3 h-3" /></div>
                </th>
                <th class="px-6 py-4 text-right cursor-pointer hover:text-ink transition-colors" data-sort="price">
                  <div class="flex items-center justify-end gap-1">Price (₹/L) <ArrowUpDown class="w-3 h-3" /></div>
                </th>
                <th class="px-6 py-4 text-right cursor-pointer hover:text-ink transition-colors" data-sort="change">
                  <div class="flex items-center justify-end gap-1">Change <ArrowUpDown class="w-3 h-3" /></div>
                </th>
                <th class="px-6 py-4"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {prices?.map((item) => (
                <tr class="hover:bg-canvas-soft transition-colors group">
                  <td class="px-6 py-4">
                    <p class="text-sm font-semibold text-ink">{item.city_name}</p>
                    <p class="text-[10px] text-mute font-mono uppercase tracking-tighter">{stateName}</p>
                  </td>
                  <td class="px-6 py-4 text-sm font-mono font-bold text-right">₹{item.petrol_price?.toFixed(2) || 'N/A'}</td>
                  <td class={`px-6 py-4 text-sm font-mono text-right ${item.price_change > 0 ? 'text-error' : item.price_change < 0 ? 'text-success' : 'text-mute'}`}>
                    {item.price_change > 0 ? '▲' : item.price_change < 0 ? '▼' : '—'} {Math.abs(item.price_change || 0).toFixed(2)}
                  </td>
                  <td class="px-6 py-4 text-right">
                    <a 
                      href={`/petrol-price-in-${citiesInState?.find(c => c.id === item.city_id)?.city_slug}`} 
                      class="inline-flex items-center gap-1 text-xs font-semibold text-mute group-hover:text-primary transition-colors"
                    >
                      View Details <ChevronRight class="w-3 h-3" />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
      
      {/* State FAQ */}
      <section class="mt-24 max-w-3xl">
        <h2 class="text-2xl font-bold text-ink mb-8">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div class="bg-canvas border border-hairline rounded-lg p-6">
            <h3 class="font-bold text-ink mb-2">What is the average petrol price in {stateName} today?</h3>
            <p class="text-body text-sm leading-relaxed">The average petrol price across various cities in {stateName} is ₹{avgPrice} per litre as of {formatDate(today)}.</p>
          </div>
          <div class="bg-canvas border border-hairline rounded-lg p-6">
            <h3 class="font-bold text-ink mb-2">Which city has the cheapest petrol in {stateName}?</h3>
            <p class="text-body text-sm leading-relaxed">{minPrice?.city_name} currently offers the lowest petrol price in the state at ₹{minPrice?.petrol_price?.toFixed(2)} per litre.</p>
          </div>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</Base>

<script>
  // Simple table sorting
  const table = document.getElementById('state-cities-table');
  const headers = table?.querySelectorAll('th[data-sort]');
  
  headers?.forEach(header => {
    header.addEventListener('click', () => {
      // Implementation of table sorting if needed
      console.log('Sort by:', header.getAttribute('data-sort'));
    });
  });
</script>
