---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Petrol Price India — Today's Petrol Price in All Cities",
	description = "Track daily petrol prices in India. Real-time updates, price history charts, and fuel cost calculator for all major cities and states."
} = Astro.props;
---

<!doctype html>
<html lang="en-IN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="PetrolPrice" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:locale" content="en_IN" />
		
		<link rel="alternate" hreflang="en-IN" href={new URL(Astro.url.pathname, Astro.site || 'https://petrolpriceindia.com')} />
		<link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, Astro.site || 'https://petrolpriceindia.com')} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="petrol price, petrol price in delhi, petrol price today, petrol price in bangalore, petrol price in pune, petrol price in india, petrol price in hyderabad, petrol price in mumbai, petrol price delhi" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site || 'https://petrolpriceindia.com')} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og-image.svg', Astro.site || 'https://petrolpriceindia.com')} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={new URL(Astro.url.pathname, Astro.site || 'https://petrolpriceindia.com')} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/og-image.svg', Astro.site || 'https://petrolpriceindia.com')} />
		
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://petrolpriceindia.com')} />
		
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "Petrol Price India",
				"url": "https://petrolpriceindia.com",
				"logo": "https://petrolpriceindia.com/favicon.svg",
				"description": "Track daily petrol prices in India. Real-time updates, price history charts, and fuel cost calculator for all major cities and states.",
				"contactPoint": {
					"@type": "ContactPoint",
					"email": "support@petrolpriceindia.com",
					"contactType": "customer support"
				}
			}
		</script>
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "Petrol Price India",
				"url": "https://petrolpriceindia.com",
				"potentialAction": {
					"@type": "SearchAction",
					"target": {
						"@type": "EntryPoint",
						"urlTemplate": "https://petrolpriceindia.com/all-cities?q={search_term_string}"
					},
					"query-input": "required name=search_term_string"
				}
			}
		</script>
		
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-QQLMPTHG7J" is:inline></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-QQLMPTHG7J');
		</script>

		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-canvas-soft text-ink font-sans selection:bg-ink selection:text-canvas dark:selection:bg-canvas dark:selection:text-ink overflow-x-hidden min-h-screen flex flex-col">
		<slot />
	</body>
</html>

<style is:global>
	html {
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		scroll-behavior: smooth;
	}

	body {
		text-rendering: optimizeLegibility;
	}

	h1, h2, h3, h4, h5, h6 {
		letter-spacing: -0.02em;
	}
</style>
