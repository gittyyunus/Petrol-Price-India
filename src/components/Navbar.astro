---
import { Sun, Moon } from '@lucide/astro';
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/favicon.svg" alt="Petrol Price India" class="h-8 w-8 transition-transform group-hover:scale-105" />
        <span class="text-xl font-semibold tracking-tight hidden sm:block">Petrol Price <span class="text-body font-normal">India</span></span>
      </a>
      
      <nav class="hidden md:flex items-center gap-1">
        <a href="/compare" class="px-3 py-1.5 text-sm font-medium text-body hover:text-ink hover:bg-canvas-soft-2 rounded-full transition-colors">Compare</a>
        <a href="/calculator" class="px-3 py-1.5 text-sm font-medium text-body hover:text-ink hover:bg-canvas-soft-2 rounded-full transition-colors">Calculator</a>
        <a href="/alerts" class="px-3 py-1.5 text-sm font-medium text-body hover:text-ink hover:bg-canvas-soft-2 rounded-full transition-colors">Alerts</a>
      </nav>
    </div>

    <div class="flex items-center gap-4">
      <button 
        id="theme-toggle"
        class="p-2 text-body hover:text-ink hover:bg-canvas-soft-2 rounded-full transition-colors"
        aria-label="Toggle dark mode"
      >
        <Sun class="h-5 w-5 hidden dark:block" />
        <Moon class="h-5 w-5 block dark:hidden" />
      </button>

      <button class="md:hidden p-2 text-body hover:text-ink">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  
  themeToggle?.addEventListener('click', () => {
    const element = document.documentElement;
    element.classList.toggle("dark");
    
    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
