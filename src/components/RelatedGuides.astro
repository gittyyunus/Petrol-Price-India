---
// RelatedGuides: 3 blog links tailored to the fuel on the page.
// Petrol/diesel lean tax+price-formation; CNG/autogas lean their own
// calculation guides plus running-cost comparison.
import { BookOpen, ArrowRight } from '@lucide/astro';

interface Props {
  fuel?: string;
}

const { fuel = 'petrol' } = Astro.props;

const GUIDES: Record<string, { title: string; href: string; blurb: string }[]> = {
  petrol: [
    {
      title: 'How Fuel Excise Duty and State VAT Are Actually Calculated',
      href: '/blog/how-fuel-excise-duty-and-state-vat-are-calculated/',
      blurb: 'Worked example of base price + excise + dealer commission + VAT — the stack behind every price on this page.',
    },
    {
      title: 'Why Petrol Prices Change at 6 AM Every Day',
      href: '/blog/why-petrol-prices-change-at-6am-and-how-omcs-calculate-them/',
      blurb: 'How IOC, HPCL and BPCL set the daily revision and why most moves are a few paise.',
    },
    {
      title: 'Why Petrol Costs ₹8–15 More Just One State Over',
      href: '/blog/why-petrol-costs-more-one-state-over-border-hopping-trick/',
      blurb: 'Border-hopping economics: when crossing a state line to fill up actually pays.',
    },
  ],
  diesel: [
    {
      title: 'Why Diesel Gives More Mileage Than Petrol',
      href: '/blog/why-diesel-gives-more-mileage/',
      blurb: 'The real physics — density, compression ratio, the missing throttle plate — with real Indian car numbers.',
    },
    {
      title: 'Petrol vs Diesel vs CNG: Real Running Costs',
      href: '/blog/petrol-vs-diesel-vs-cng-running-costs/',
      blurb: 'Tracked ownership costs across fuels — when diesel still wins and when it stopped winning.',
    },
    {
      title: 'Why Diesel Is Cheaper Than Petrol',
      href: '/blog/why-diesel-is-cheaper-than-petrol/',
      blurb: 'Lower excise, lighter state VAT, and the history — with the official 2026 build-up worked out.',
    },
  ],
  cng: [
    {
      title: 'How CNG Prices Are Actually Calculated in India',
      href: '/blog/how-cng-prices-are-calculated-in-india/',
      blurb: 'Domestic gas pooling, compressor costs and state VAT on CNG explained.',
    },
    {
      title: 'Petrol vs Diesel vs CNG: Real Running Costs',
      href: '/blog/petrol-vs-diesel-vs-cng-running-costs/',
      blurb: 'Per-km math across all three fuels with real mileage figures.',
    },
    {
      title: 'Why CNG Is Better Than Petrol in India',
      href: '/blog/why-cng-is-better-than-petrol/',
      blurb: 'Cost-per-km math, kit payback, emissions data and where petrol still wins.',
    },
  ],
  autogas: [
    {
      title: 'How Autogas (LPG) Prices Are Actually Calculated in India',
      href: '/blog/how-autogas-lpg-prices-are-calculated-in-india/',
      blurb: 'Import parity, bottling costs and why AutoGas tracks crude differently.',
    },
    {
      title: 'Petrol vs Diesel vs CNG: Real Running Costs',
      href: '/blog/petrol-vs-diesel-vs-cng-running-costs/',
      blurb: 'Where AutoGas fits in the per-km ranking for city runabouts.',
    },
    {
      title: 'EV vs Petrol: Real 5-Year Ownership Cost',
      href: '/blog/ev-vs-petrol-car-5-year-ownership-cost/',
      blurb: 'Long-horizon math if you are weighing a fuel switch against going electric.',
    },
  ],
};

const guides = GUIDES[fuel] ?? GUIDES.petrol;
---

<section class="bg-canvas border border-hairline rounded-xl p-8 shadow-sm">
  <div class="flex items-center gap-2 mb-2">
    <BookOpen class="w-4 h-4 text-mute" />
    <h2 class="text-sm font-bold uppercase tracking-wider text-mute">Related guides</h2>
  </div>
  <div class="grid sm:grid-cols-3 gap-4 mt-4">
    {guides.map((g) => (
      <a href={g.href} class="group block border border-hairline rounded-xl p-5 hover:border-primary transition-colors bg-canvas-soft-2/40">
        <h3 class="font-bold text-ink text-sm leading-snug mb-2 group-hover:text-primary transition-colors">{g.title}</h3>
        <p class="text-xs text-body leading-relaxed mb-3">{g.blurb}</p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary">Read guide <ArrowRight class="w-3 h-3" /></span>
      </a>
    ))}
  </div>
</section>
