---
// Clean, accessible Cookie Consent Banner for Google AdSense & Analytics compliance
---

<div
  id="cookie-consent-banner"
  role="region"
  aria-label="Cookie consent"
  class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 hidden bg-canvas border border-hairline rounded-2xl p-5 shadow-xl transition-all duration-300"
>
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-sm font-bold text-ink">Cookie & Privacy Settings</h3>
    </div>
    <p class="text-xs text-body leading-relaxed">
      We use cookies and similar technologies to measure audience traffic, ensure site security, and deliver relevant advertisements in accordance with Google Publisher Policies and our <a href="/privacy" class="text-primary hover:underline font-semibold">Privacy Policy</a>.
    </p>
    <div class="flex items-center gap-2 pt-1">
      <button
        id="cookie-accept-all"
        type="button"
        class="flex-1 bg-primary text-canvas px-4 py-2 rounded-xl text-xs font-semibold hover:bg-ink transition-colors cursor-pointer text-center"
      >
        Accept All
      </button>
      <button
        id="cookie-necessary-only"
        type="button"
        class="flex-1 bg-canvas-soft-2 text-ink border border-hairline px-4 py-2 rounded-xl text-xs font-semibold hover:bg-canvas-soft transition-colors cursor-pointer text-center"
      >
        Necessary Only
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const banner = document.getElementById('cookie-consent-banner');
    const acceptBtn = document.getElementById('cookie-accept-all');
    const necessaryBtn = document.getElementById('cookie-necessary-only');
    if (!banner || !acceptBtn || !necessaryBtn) return;

    const consentKey = 'ppi_cookie_consent_v1';
    const stored = localStorage.getItem(consentKey);

    if (!stored) {
      // Small timeout so it doesn't flicker during initial render
      setTimeout(() => {
        banner.classList.remove('hidden');
      }, 500);
    }

    const closeBanner = (status) => {
      localStorage.setItem(consentKey, status);
      banner.classList.add('opacity-0', 'translate-y-4');
      setTimeout(() => {
        banner.classList.add('hidden');
      }, 300);
    };

    acceptBtn.addEventListener('click', () => closeBanner('accepted'));
    necessaryBtn.addEventListener('click', () => closeBanner('necessary'));
  })();
</script>

