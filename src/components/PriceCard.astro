---
import { TrendingUp, TrendingDown, Minus } from '@lucide/astro';

interface Props {
  city: string;
  state: string;
  price: number | null;
  change: number | null;
  lastUpdated: string;
  large?: boolean;
  slug?: string;
  fuel?: string;
}

const { city, state, price, change, lastUpdated, large = false, slug, fuel = 'petrol' } = Astro.props;

const citySlug = slug || city.toLowerCase().replace(/ /g, '-');

const isUp = (change || 0) > 0;
const isDown = (change || 0) < 0;
const isSame = (change || 0) === 0;

const formattedPrice = price?.toFixed(2) || 'N/A';
const formattedChange = Math.abs(change || 0).toFixed(2);
---

<div class={`bg-canvas border border-hairline rounded-lg shadow-sm overflow-hidden ${large ? 'p-8' : 'p-6'}`}>
  <div class="flex justify-between items-start mb-4">
    <div>
      <h3 class={`${large ? 'text-2xl' : 'text-lg'} font-semibold text-ink`}>{city}</h3>
      <p class="text-xs text-mute font-medium uppercase tracking-wider">{state}</p>
    </div>
    <div class={`flex items-center gap-1 px-2 py-1 rounded-full text-xs font-semibold ${
      isUp ? 'bg-error/10 text-error' : 
      isDown ? 'bg-success/10 text-success' : 
      'bg-mute/10 text-mute'
    }`}>
      {isUp && <TrendingUp class="w-3 h-3" />}
      {isDown && <TrendingDown class="w-3 h-3" />}
      {isSame && <Minus class="w-3 h-3" />}
      <span>{isUp ? '+' : isDown ? '-' : ''}{formattedChange}</span>
    </div>
  </div>
  
  <div class="flex items-baseline gap-1 mb-2">
    <span class={`${large ? 'text-5xl' : 'text-3xl'} font-bold text-ink tracking-tight`}>₹{formattedPrice}</span>
    <span class="text-mute font-medium">/litre</span>
  </div>
  
  <p class="text-[10px] font-mono text-mute uppercase tracking-widest">
    Last updated: {lastUpdated}
  </p>
  
  {large && (
    <div class="mt-8 pt-8 border-t border-hairline flex gap-4">
      <a href={`/${fuel}-price-in-${citySlug}`} class="flex-1 bg-primary text-canvas text-center py-3 rounded-full text-sm font-semibold hover:bg-ink/90 transition-colors">
        View History
      </a>
      <button class="flex-1 bg-canvas border border-hairline text-ink py-3 rounded-full text-sm font-semibold hover:bg-canvas-soft-2 transition-colors">
        Set Alert
      </button>
    </div>
  )}
</div>
